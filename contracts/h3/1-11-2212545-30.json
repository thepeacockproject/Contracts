    "Metadata": {
        "Id": "c9b50596-17aa-4fa2-8d0e-3f17f8cd5988",
        "Type": "usercreated",
        "Title": "Choking on a Hot Dog",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111221254530",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 8c2c1042-3bdd-4197-9dd2-85c605776cd6).Image",
        "Description": "The last time I went to the races, I ate my hot dog too fast and choked a little! It was very embarrasing. I want the vendor who sold me the weiner to suffer as I did. The problem is, I ate so many hot dogs that day and I can&apos;t remember which vendor sold me the homicidal meat tube! Embarrass them all for me, would you?",
        "GameVersion": "8.7.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_MIAMI"
        ],
