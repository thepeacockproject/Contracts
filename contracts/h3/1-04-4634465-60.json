    "Metadata": {
        "Id": "e9878b62-f256-4978-9d46-d9ce7c7de132",
        "Type": "usercreated",
        "Title": "Better Call Salvatore",
        "Location": "LOCATION_COASTALTOWN_NIGHT",
        "PublicId": "104463446560",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_mamba.entity",
        "TileImage": "$($repository 4f388b6a-0fe0-4119-a9b3-1792922ce76e).Image",
        "Description": "Ciao, sono Salvatore Bravuomo. Lo sapevi che hai dei diritti? Lo dice la Costituzione. E lo dico anch&apos;io. Credo che fino a prova contraria, ogni uomo, donna e bambino in questo Paese sia innocente. Ed è per questo che lotto per te, Sapienza! Meglio che chiami Salvadore!",
