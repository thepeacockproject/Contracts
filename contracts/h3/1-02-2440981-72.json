    "Metadata": {
        "Id": "33c21c3f-707d-4553-9f4b-5ad49ac6295c",
        "Type": "usercreated",
        "Title": "The Dry Alcoholics",
        "Location": "LOCATION_PARIS",
        "PublicId": "102244098172",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Paris/_scene_paris.entity",
        "TileImage": "$($repository 23c918e7-1110-42b0-aeca-29d32d8d2dcd).Image",
        "Description": "47,\r\rYour targets are attending a social event in Paris.  The client states these four women know each other, and are responsible for having planned out the poisoning of an old friend.\r\rThe client would like you to exterminate them in a rather peculiar way.  She would rather you &quot;not let them enjoy a drink on their way out.&quot;  Instead, she specifically wants them to die feeling dry and dehydrated.  Even though they are drinkers,  I&apos;m afraid you cannot poison their drinks, 47.\r\rDiana Burnwood",
        "GameVersion": "8.5.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_PARIS"
        ],
