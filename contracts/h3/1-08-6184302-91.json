    "Metadata": {
        "Id": "866f467c-7fa5-44ff-b46a-54c1f3a1665c",
        "Type": "usercreated",
        "Title": "Five same faces of death",
        "Location": "LOCATION_BANGKOK",
        "PublicId": "108618430291",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Bangkok/_scene_tiger.entity",
        "TileImage": "$($repository 16e3b83f-846a-472c-b191-2bd389f34f0b).Image",
        "Description": "At the luxurious Himmapan Hotel, a recording session has taken a deadly turn. Intelligence has uncovered a conspiracy involving five members of the studio crew assigned to the production of Jordan Cross’s latest album. Secretly financed by the artist’s own producer, the quintuplets  intends to stage Cross’s death as a tragic accident, believing his sudden demise at the height of fame will immortalize him among music’s infamous “27 Club” and send record sales soaring.",
