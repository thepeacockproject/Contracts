    "Metadata": {
        "Id": "a5c61b44-4be0-4916-8743-2c0ab63a1b61",
        "Type": "usercreated",
        "Title": "Gestur and the Curse of the Bucket Hat",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129965749723",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository 500b7132-f583-4365-83d1-786c783c61c3).Image",
        "Description": "Our client, Gestur, has become the victim of a curse. whenever he is near the mentioned bucket hat for 24 hours, he travels back in time. unfortunately the drug dealer in ownership of said hat and his lackeys keep pestering him to purchase more drugs, and Gestur has asked our help to break the cycle. he has ensured us that he can survive death and doesn&apos;t mind being a target here. strange, but money is money, wouldn&apos;t you say 47? oh, and make it look accidental where possible.",
        "GameVersion": "8.1.0.0",
