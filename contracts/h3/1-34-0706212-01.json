    "Metadata": {
        "Id": "6cba8e0a-56b6-4839-bd32-dcc997c25ba8",
        "Type": "usercreated",
        "Title": "The running guard &amp; the narcoleptic cook",
        "Location": "LOCATION_ROCKY_DUGONG",
        "PublicId": "134070621201",
        "ScenePath": "assembly:/_pro/scenes/missions/Rocky/scene_dugong.entity",
        "TileImage": "$($repository 4b4a23d9-8dac-411a-8555-e8e3859f5133).Image",
        "Description": "Good afternoon, 47.\r\rYour target is Anup Hayer, a look out for the island pirates.\r\rHe is good friends with a local cook, who&apos;s suffering from narcolepsy, and will often come running to assist if his friend falls asleep on duty.\r\rUse this knowledge to your advantage.\r\rYour only means of leaving the island is by boat, but the engine is said to be malfunctioning, and will need a repare first.\r\rSeeing as you&apos;re quite handy, and have a good eye, I&apos;m sure you&apos;ll solve the issue.\r\rGood luck, agent.",
