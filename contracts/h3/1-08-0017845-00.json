    "Metadata": {
        "Id": "ef45b8fe-ec3d-4d71-a127-6d3b7e9ab12c",
        "Type": "usercreated",
        "Title": "Clean Poisoner 47",
        "Location": "LOCATION_BANGKOK",
        "PublicId": "108001784500",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Bangkok/_scene_tiger.entity",
        "TileImage": "$($repository f65fff84-6cad-4a11-9a0a-b89430c03397).Image",
        "Description": "Five names.\nFour drinks. One blade. No mistakes.\n\nMagnu, Ken Morgan, Al D’Andrea, and Nathan “Napalm” Palmer must all fall quietly through ingested poison. Mekhla Mahagitsiri is the exception — her end must be delivered up close with the ICA Combat Axe.\n\nThis operation demands precision above all else. No unnecessary force, no reckless shots, no loose ends. Every bullet must land cleanly, and no one is to be subdued under any circumstances.\n\nA flawless poisoner leaves behind confusion, not chaos.",
        "GameVersion": "8.23.0.88",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_BANGKOK"
        ],
