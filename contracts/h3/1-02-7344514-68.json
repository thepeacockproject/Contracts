    "Metadata": {
        "Id": "8495da1e-a451-4f62-9373-71865ca06aa9",
        "Type": "usercreated",
        "Title": "Scott Sarno &quot;The Director&quot;",
        "Location": "LOCATION_PARIS",
        "PublicId": "102734451468",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Paris/_scene_paris.entity",
        "TileImage": "$($repository 65c6eafe-a9a1-42d9-99f8-5796507117e0).Image",
        "Description": "Director Scott Sarno is a veteran of dirty wars and operations in every hell-hole warzone of the modern era. Thirty years ago he was the leader of a six-man black ops unit operating north of Sarajevo. The operation to target and acquire the contents of a looted bank went wrong, and a group of civilians were caught in the cross-fire. Sarno and his team pulled out without casualties and the event was never investigated. Since then, Sarno has risen to become director of European Operations for the CICADA PMC, where he oversees their highest-profile operations, and coordinates their activities across continental Europe.",
