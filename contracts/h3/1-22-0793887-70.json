    "Metadata": {
        "Id": "55cd301c-ac1d-4f55-bae2-27e3dd2d3b16",
        "Type": "usercreated",
        "Title": "The Surreptitious Exploitation",
        "Location": "LOCATION_NORTHAMERICA",
        "PublicId": "122079388770",
        "ScenePath": "assembly:/_pro/scenes/missions/skunk/scene_skunk.entity",
        "TileImage": "$($repository f162d97b-fce4-4b4e-a8bd-ee92583f5300).Image",
        "Description": "Nobody likes a nosy neighbor, especially ones who snoop through your belongings. Alfred &amp; Penelope Troutt both believe themselves to be regular sleuths because of their suspicions about the Wilson family being secret KGB operatives. Their worries are not entirely off-base, but it&apos;s better for everyone if we close up mouthy loose ends. Afterwards, be sure to dispose of the Wilsons as well. They are secret mouthpieces for Janus&apos; operations in Whittleton, Agent 47, and we both know that&apos;s enough.",
        "GameVersion": "8.6.0.0",
