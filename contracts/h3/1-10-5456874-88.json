    "Metadata": {
        "Id": "3f588ca1-1ef9-48a5-b8e5-68869815acdd",
        "Type": "usercreated",
        "Title": "Deadly Fugu Cake",
        "Location": "LOCATION_HOKKAIDO",
        "PublicId": "110545687488",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/_scene_snowcrane.entity",
        "TileImage": "$($repository efae226f-f38a-4cac-b0bf-c66d4463f617).Image",
        "Description": "47 — This is Diana — sorry to disturb your peace in Japan, but we have another mission for you.\r\rMasayoshi Sakakihara, a well-known criminal yakuza boss, is enjoying a vacation in Japan. Despite his fearsome reputation, Masayoshi has a soft spot for one simple pleasure: cake.\rAlso, the security team that accompanies Masayoshi has been enjoying some relaxation therapy. As a part of their routine, they have been indulging in hot springs and traditional Japanese baths.\r\rEliminate all targets.",
