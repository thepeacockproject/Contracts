    "Metadata": {
        "Id": "f48202d2-cf72-4227-a6d8-5c606466a566",
        "Type": "usercreated",
        "Title": "Operation: Bodyguard&apos;s Boat Burglary",
        "Location": "LOCATION_PARIS",
        "PublicId": "102584866274",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Paris/_scene_paris.entity",
        "TileImage": "$($repository 857ae943-2efd-454c-ac43-07aa49cca43f).Image",
        "Description": "Hello Agent,\r\rI regret to inform you that the ICA has run out of funds again, and the Helicopter&apos;s money didn&apos;t last long. Fortunately, we have a backup plan. Instead of some Nobody&apos;s Helicopter, target the Speedboat owned by Novikov and Margolis&apos;s Bodyguards. We’ve provided a location-themed explosive device and lethal poison. The keys to their boat should be in the Museum Owner&apos;s Study on the second floor. Good luck, Agent.",
