    "Metadata": {
        "Id": "676f8ee5-572f-4731-b61e-618c0d05aae2",
        "Type": "usercreated",
        "Title": "The Wire",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111103255352",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 36b85be9-4c56-491a-8413-4d3292b596e9).Image",
        "Description": "How long has it been since you&apos;ve enjoyed yourself a nice garrotting, agent? Too long, right?\r\rA gang of assassins has infiltrated a Miami race track and are planning a high-profile murder of an Army general. The Army doesn&apos;t want word of this plot getting out, and have paid us to take care of the problem quietly. Bring your fiber wire.",
