    "Metadata": {
        "Id": "6872e7d5-9b01-4aa9-8f8e-2a4faf7db58a",
        "Type": "usercreated",
        "Title": "Delivery Guy has a DJ Dream!",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129544995701",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository abd1c0e7-e406-43bd-9185-419029c5bf3d).Image",
        "Description": "In the electric nights of Berlin, where the heartbeat of techno music resonates with the city&apos;s soul, an extraordinary tale unfurls - that of a delivery guy with an insatiable DJ dream in the legendary Club Hölle. As the nightclubs come alive with neon lights and pulsating rhythms, the delivery guy seeks to use his passion for music to create a euphoric climax that would elevate the crowd to ecstatic heights. But, accidents could happen… Use this opportunity to eliminate two unexpected guests!",
        "GameVersion": "8.12.0.0",
