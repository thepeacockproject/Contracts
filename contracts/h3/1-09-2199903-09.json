    "Metadata": {
        "Id": "4a79c640-2ef6-447c-942d-0b5e660a8c77",
        "Type": "usercreated",
        "Title": "A Haunting In Colorado",
        "Location": "LOCATION_COLORADO",
        "PublicId": "109219990309",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Colorado_2/_scene_bull.entity",
        "TileImage": "$($repository d78b0462-d8b8-4651-90a5-9ff14d043b25).Image",
        "Description": "A bit of an odd one, 47. The FBI is attempting to infiltrate a militia terrorist cell on a farm in Colorado. They have learned that it&apos;s leader, Sean Rose, is extremely paranoid and has a fear of the supernatural. Your mission is to create a series of apparent paranormal caused deaths. Rose will then likely make contact with a clairvoyent as he has done in the past. An FBI deep cover agent will then infiltrate the compound, posing as the ghost whisperer.",
        "GameVersion": "8.13.0.0",
        "IsPublished": true,
        "Entitlements": [
