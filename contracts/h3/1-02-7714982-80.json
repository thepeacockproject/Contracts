    "Metadata": {
        "Id": "f1addb47-f222-4a22-b940-50a5f11519a2",
        "Type": "usercreated",
        "Title": "The Five Fashionistas",
        "Location": "LOCATION_PARIS",
        "PublicId": "102771498280",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Paris/_scene_paris.entity",
        "TileImage": "$($repository f7504015-a010-4828-813d-accb23edc287).Image",
        "Description": "Our client Dalia Margolis has hired us to take these five fine women out tonight. McKenzie accuses Marigolds of running a spy ring. She plans to interview Bourque and Vladimir who are ex-IAGO agents willing to confess to everything. Lana Caprice is working on an investigation of her own as well.\r\rAnd Lindsey La Coeur said neon and pastels would be &apos;in&apos; this season. She lied. Sanguine lost millions because of it. Ready to shake up the fashion world 47?",
        "GameVersion": "8.1.0.0",
        "IsPublished": true,
        "Entitlements": [
