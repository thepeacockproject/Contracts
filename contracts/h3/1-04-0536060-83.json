    "Metadata": {
        "Id": "32b180a7-11f9-46ec-8d20-ca8dd599a7e0",
        "Type": "usercreated",
        "Title": "The rich &amp; mighty #5: The saint &amp; singer",
        "Location": "LOCATION_COASTALTOWN_NIGHT",
        "PublicId": "104053606083",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_mamba.entity",
        "TileImage": "$($repository c823beec-3d73-47b6-87d9-076c384c4662).Image",
        "Description": "Padre Francesco has been having an affair with well known singer Cristina Dionisi. The ring found out about the affair and both lovebirds were permanently kicked from the ring.  This makes them very easy targets and both will be in the area due to a recent campaign tour of mayoral canidate March Abiatti.  Be quick as you can as Cristani is only scheduled  to be singing for under 30 minutes, and Padre has a service at 6:00. Good luck 47",
