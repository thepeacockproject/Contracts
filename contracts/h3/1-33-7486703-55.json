    "Metadata": {
        "Id": "10212dce-d1f4-483f-94f6-f84f22e873e4",
        "Type": "usercreated",
        "Title": "Two Poisonings and a Drowning",
        "Location": "LOCATION_ANCESTRAL_SMOOTHSNAKE",
        "PublicId": "133748670355",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_smoothsnake.entity",
        "TileImage": "$($repository 486c204d-773b-4103-b4f4-829a3d944161).Image",
        "Description": "47, thanks for covering for me. I&apos;d really appreciate if you took care of the targets using my methods so ICA won&apos;t notice my absence. Maybe I should reconsider my M.O. - would make it easier for people to step in. Anyway, don&apos;t do what I did - do not, under ANY CIRCUMSTANCES, lick the frogs! I know, it&apos;s very tempting and the trip is definitely worth it but we can&apos;t risk you being too high to work as well. I mean, who else is gonna step in? Steve? Guy&apos;s a prick.\r\rThanks again!\r\r- Agent 420",
        "GameVersion": "8.10.0.0",
        "IsPublished": true,
