    "Metadata": {
        "Id": "b5871362-02b8-4c2c-af19-0b549fb71de2",
        "Type": "usercreated",
        "Title": "BCR VOL. 80 - Time Theft",
        "Location": "LOCATION_BANGKOK_ZIKA",
        "PublicId": "116749027402",
        "ScenePath": "assembly:/_pro/scenes/missions/Bangkok/scene_zika.entity",
        "TileImage": "$($repository ea65261d-d657-4e7f-8e3b-7027e637e673).Image",
        "Description": "47, our client is concerned with slimming the payroll margins of the staff at the Himmapan Hotel. They are concerned that Oybek Nabazov&apos;s event is overstaffed, and some employees present tonight are engaged in &quot;time theft&quot; - a real and preventable harm to corporate revenue and efficiency.\r\rIt&apos;s time for these slackers to drop their mops and clock out - permanently.\r\rI suggest you don&apos;t loaf around while you&apos;re fulfilling this contract, 47. Anything less than your fastest time, may be time theft.",
