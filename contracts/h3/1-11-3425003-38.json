    "Metadata": {
        "Id": "1762b08b-dc04-40a6-a5ba-475bc237ca60",
        "Type": "usercreated",
        "Title": "NinjaGoPro XII - South Beach Shinobi",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111342500338",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository a5c4a3e8-40d6-497b-a688-c65611161cba).Image",
        "Description": "Our client is making yet another cheap ninja movie. Honestly, I think he’s mailing it in with these ideas, but film criticism isn’t our profession. Miami will make an exciting backdrop for the film, so don your ninja gear and eliminate the designated targets in Shinobi style. The four targets this time are part of a calypso band, Steal Drumz, which provided soundtrack music for our client’s past movies. They want to get paid for their work, and the budget just won’t allow for such an indulgence.",
        "GameVersion": "8.7.0.0",
        "IsPublished": true,
