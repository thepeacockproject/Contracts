    "Metadata": {
        "Id": "78befb19-1e1d-47bc-bb69-85a1ada1a908",
        "Type": "usercreated",
        "Title": "Kill the Providence prisoner.",
        "Location": "LOCATION_COLORADO",
        "PublicId": "109481435614",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Colorado_2/_scene_bull.entity",
        "TileImage": "$($repository 6582bac1-bc45-452b-929e-ce4c5afd2a4e).Image",
        "Description": "Your target is William Candler, a former providence herald. Candler has been captured by an enemy militia and is currently being interrogated. You must eliminate him before he gives them critical info. The target is locked behind bulletproof glass, and there is no key. You&apos;ll need to make use of a secret trick using an explosive device. You are also to eliminate both the guards in the interrogation room using the same device. Time is of the essence, 47. I will leave you to prepare.",
