    "Metadata": {
        "Id": "484a2319-7614-44c9-adf3-6fc7931a992e",
        "Type": "usercreated",
        "Title": "Der Mörder war wieder mal der Gärtner",
        "Location": "LOCATION_ANCESTRAL_BULLDOG",
        "PublicId": "128527792026",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_bulldog.entity",
        "TileImage": "$($repository 5c5ec41e-b4c6-43d4-a2df-364a4f340dcc).Image",
        "Description": "Die Nacht liegt wie Blei auf Schloss Darkmoor\rSir Henry liest Financial Times\rZwölf mal schlägt gespenstisch die Turmuhr\rDer Butler hat Ausgang bis eins\rDa schleicht sich im flackernden Lampenschein\rFast lautlos ein Schatten zur Türe herein\rUnd stürzt auf Sir Henry, derselbe lebt ab\rUnd nimmt das Geheimnis mit in das Grab\r\rDer Mörder war wieder der Gärtner\rUnd er plant schon den nächsten Coup\rDer Mörder ist immer der Gärtner\rUnd der schlägt erbarmungslos zu",
        "GameVersion": "8.24.0.0",
