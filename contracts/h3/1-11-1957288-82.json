    "Metadata": {
        "Id": "4c3b15e1-0143-4b29-9348-57b119124490",
        "Type": "usercreated",
        "Title": "Oceans 47",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111195728882",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 9b0d0651-4f81-40e5-bf2a-5aec6fd763a5).Image",
        "Description": "Greetings, 47.\r\rFour ICA agents are being held captive in Kronstadt HQ. Three are intelligence operatives specializing it aquatic extraction tactics who might very well hold the secret to a quick escape. They are being detained in tanks 6, 7, and 14, respectively.\r\rThe fourth is their bodyguard; a master combatant with vital intel on how to eliminate the head of the private military company who captured them. He is being detained in tank 12.\r\rFind them, free them, and escort them to safety.",
