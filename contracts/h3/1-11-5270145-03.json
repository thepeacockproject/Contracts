    "Metadata": {
        "Id": "0486bc33-4932-4ac9-8dc9-3af1a0b2f01a",
        "Type": "usercreated",
        "Title": "Старый обычай",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111527014503",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 14ef9606-229b-4ee5-9f79-bd8fa7893e1e).Image",
        "Description": "Доброе утро агент 47. Вчера нам нам поступил крайне интересный контракт на нейтрализацию дорговой наркосети, в знакомом тебе месте с машинками. Интересна твоя задача тем что продажа &quot;лекарств&quot; санкционированна старыми знакомыми, мелкая страна под названием Контилия, снова взялась за знакомый метод соботажа конкретных регионов-противников, в виду своего интереса об их получении. Полные мотивы Контилии еще не раскрыты, а наш заказчик остался анонимным. Это все усложняет...\rGood luck, fortu seven.",
        "GameVersion": "8.24.0.0",
