    "Metadata": {
        "Id": "609cbae1-7bf0-41a1-afad-b78cec57280e",
        "Type": "usercreated",
        "Title": "Garden Sense",
        "Location": "LOCATION_ANCESTRAL_SMOOTHSNAKE",
        "PublicId": "133993208900",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_smoothsnake.entity",
        "TileImage": "$($repository 486c204d-773b-4103-b4f4-829a3d944161).Image",
        "Description": "Sebastian Sato, renowned green thumb? Don´t make me laugh.\r\rHe belongs where the catwalk is it, behind the scenes, and pulling the most risky fashion stunts off on one day to become trends the next.\r\rIt´s so pathetic to see his gift wasted on the backyard and not on the front pages of Fashion Weekly. I´ve decided I´ll take the matter into my hands; I will make everyone follow their dreams, regardless the cost\r\rIf only Sato could understand his genius. \r\r Contract by: The ScriptDesk",
        "GameVersion": "8.6.0.0",
