    "Metadata": {
        "Id": "4f03fbca-33d6-40aa-bc39-4a7b089d345c",
        "Type": "usercreated",
        "Title": "ky&apos;ll kill &apos;em with class",
        "Location": "LOCATION_BANGKOK",
        "PublicId": "108610285409",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Bangkok/_scene_tiger.entity",
        "TileImage": "$($repository fa24b1ba-a2ed-4e6b-a711-3eca937196b7).Image",
        "Description": "Everything was planned for Ky&apos;s surprise party, but some lazy mates forgot to do their part.\r\rFred forgot to bring the drinks, Gabriel didn&apos;t fill the gas tank for the barbecue, Thijs showed up empty-handed when he was supposed to bring the gift, Edgar ordered a tiny cake, and the cherry on top? Geoff dropped it on the floor...\r\rMaybe they should be the ones to receive a surprise and pay a fair price for their negligence.\r\rHave fun Ky, kill them with your class and enjoy your birthday!\r\rallosart",
        "GameVersion": "8.24.0.0",
        "IsPublished": true,
