    "Metadata": {
        "Id": "de5e0634-3e39-4c2a-b202-3f0a727efb5c",
        "Type": "usercreated",
        "Title": "Welcome back, Agent 17 №1",
        "Location": "LOCATION_HOKKAIDO",
        "PublicId": "110694924886",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/_scene_snowcrane.entity",
        "TileImage": "$($repository 3a34f128-b441-40dc-be2e-e2485733ee39).Image",
        "Description": "Eighteen years later, after the unfortunate incident that occurred in St. Petersburg, we have finally managed to save you. We performed the most complex surgeries on the human body, and yet we managed to save you. Now you are undergoing recovery procedures in Hokkaido, a place that has been like a second home to you for a year. Your time has come again. Your task is to quietly eliminate two guards who know too much. Then head straight for the exit, where our employees will meet you. Goodbye, 17s",
        "GameVersion": "8.24.0.0",
