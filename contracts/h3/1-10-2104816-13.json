    "Metadata": {
        "Id": "5d2d4f88-e152-42df-869e-360f616bda59",
        "Type": "usercreated",
        "Title": "SECOND CHANCE",
        "Location": "LOCATION_HOKKAIDO",
        "PublicId": "110210481613",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/_scene_snowcrane.entity",
        "TileImage": "$($repository 70a7be55-5925-4ad1-aaf2-40042346e01f).Image",
        "Description": "At GAMA, a second chance at life is no longer reserved for the wealthy.\r\n\nPatients arrive seeking new faces. But why stop there?\n\rBodyguards, security officers, even doctors — all have been given a new identity. Or rather, the same one.\n\r\nSix men. Six identical faces. One original.\r\n\nA breakthrough in reconstructive surgery? Perhaps.\n\rUnfortunately, the experiment has produced five unauthorized copies.\n\n\rAnd while GAMA prides itself on giving people a second chance, the original has no intention of sharing his face.\n\n\rYour assignment is simple, 47.\n\n Preserve the original. Eliminate the copies.\rFive targets. One face.\n \nNo second chances.\n\rGood hunting.",
        "GameVersion": "8.25.0.95",
