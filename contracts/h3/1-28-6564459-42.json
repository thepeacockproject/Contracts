    "Metadata": {
        "Id": "ea4c43c6-1e9b-4a77-800f-5f92e504a492",
        "Type": "usercreated",
        "Title": "BCR VOL. 103 - A Night to Dismember",
        "Location": "LOCATION_ANCESTRAL_BULLDOG",
        "PublicId": "128656445942",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_bulldog.entity",
        "TileImage": "$($repository 1e6834c9-ed62-4f73-a5a2-864bc52eab2c).Image",
        "Description": "Good evening, 47.\rAfter several drinks, Patrick and Edward Carlisle confidently bet the family estate on the final question of a pub quiz.\rThey got it wrong. Three of their own staff got it right.\rUnfortunately, the agreement was written on a napkin, signed by both Carlisles, and witnessed by half the pub.\rAlexa wants all five removed before the staff move into the master bedrooms.\rPreserve the napkin, though. Apparently, it’s the first thing Patrick has signed without asking for money.\rBy Twice",
