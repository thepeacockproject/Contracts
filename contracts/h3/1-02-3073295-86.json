    "Metadata": {
        "Id": "ffa140a9-a6e9-47b0-8d25-7f2cf7a8cd6a",
        "Type": "usercreated",
        "Title": "imsom Shaboingry: Publication Troubles",
        "Location": "LOCATION_PARIS",
        "PublicId": "102307329586",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Paris/_scene_paris.entity",
        "TileImage": "$($repository bc631938-35c0-47ab-9e62-3bae05920ea7).Image",
        "Description": "47, a new contract for you. Jay Smart, cameraman in charge for coverage of the Sanguine fashion show is currently doing more than his regular job. He&apos;s doing intelligence work for our anonymous suspect. All we have on this suspect is his short brown hair and bushy mustache. We were able to narrow down two identical people. Without any intel or way to deduce which is which, you are required to kill both. Leave the dressing up for the models, and keep your kills as clean as possible. Good luck, 47",
        "GameVersion": "8.24.0.0",
