    "Metadata": {
        "Id": "2950c537-2dd4-47b7-b901-fd429ae84e6b",
        "Type": "usercreated",
        "Title": "Elimination Order: Orson and Alma",
        "Location": "LOCATION_NEWZEALAND",
        "PublicId": "120165647526",
        "ScenePath": "assembly:/_pro/scenes/missions/sheep/scene_sheep.entity",
        "TileImage": "$($repository 293579a3-b1d9-415a-ad3f-9f876892d9b1).Image",
        "Description": "It seems the Bonnie of old has found a new Clyde for herself. The client has lost two close friends to this duo, and now requests their eliminations.\r\rOrson Mills has been brutalising his victims using a katana, while Alma Reynard has been causing explosions to take out targets. The client requests that you kill them in the same manner\r\rIn addition, the client requests that their bodies are not found, to prevent them becoming martyrs. Your discrection is also preferred, naturally\r\rGood luck, 47.",
