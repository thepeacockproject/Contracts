    "Metadata": {
        "Id": "1b8b0118-c376-4b52-9a81-0b18768cec20",
        "Type": "usercreated",
        "Title": "Неоновый защитник",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129350392843",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository 90af6077-eeb9-4681-b64c-cc1e512f9682).Image",
        "Description": "Доброе утро, 47. Сегодня на поступил контракт на пятерых людей, которые называют себя &quot;Неоновая пятёрка&quot;. Такие люди устраивают перестрелки в ночных клубах. Они уже совершили акт насилия в клубе &quot;Рай&quot; в Детройте, &quot;Неоновый танец&quot; в Сан-Франциско и &quot;Огниво&quot; в Лас-Вегасе. Сейчас они присматриваются к новому ночному клубу в Берлине и вскоре будут готовить нападение. Это нужно предотвратить, 47. Их босс - Имануэль Кнэп. Бесспринципный и хладнокровный человек, который будет с ними в клубе. \rУдачи, 47",
        "GameVersion": "8.23.0.0",
