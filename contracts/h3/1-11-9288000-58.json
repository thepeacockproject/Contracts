    "Metadata": {
        "Id": "1a3373ae-aac8-4d32-873f-a0ae3b31e7c1",
        "Type": "usercreated",
        "Title": "Flamboyant Imposters",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111928800058",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 35b393a7-7b60-48d8-9507-7b1993daa7a9).Image",
        "Description": "There are two  imposters who are parading around as though they are one of us. \r\rDispatch them quietly, and leave no witnesses. Do not be a coward and subdue any pitiful non-flamingo kind that dare stand in your way. Instead spill their blood if needed and grant them an honourable death. \r\rFirearms are a cowards weapon so it is imperrative you use a blade to eliminate the dopplegangers. The japanese tanto knife is recommended, although any other blade will suffice. \r\rMake quick work of them.",
