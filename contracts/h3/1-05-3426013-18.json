    "Metadata": {
        "Id": "e8bb7aeb-675d-4952-a4a5-161d24eada03",
        "Type": "usercreated",
        "Title": "A Deep Red Blade",
        "Location": "LOCATION_COASTALTOWN_MOVIESET",
        "PublicId": "105342601318",
        "ScenePath": "assembly:/_pro/scenes/missions/coastaltown/_scene_copperhead.entity",
        "TileImage": "$($repository 005e3ab8-508c-471b-8426-53aca5c6ef4b).Image",
        "Description": "In 1975, iconic Giallo director Lamberto Parva was filming his unfinished masterpiece &quot;The Moonlit Blade&quot;. His daughter, who had the leading role, died on set in a mysterious accident. \r\rParva recently came to us with irrefutable evidence that the accident was staged by masters of trickery : director Dino Bosco, his manager, Sophia Wilde and special effects artist Amaranto Mazzi. \r\rTonight will come Parva&apos;s revenge. Get hold of the Moonlit Blade and give their newest production a bloody twist.",
        "GameVersion": "8.1.0.0",
        "IsPublished": true,
