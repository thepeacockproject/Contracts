    "Metadata": {
        "Id": "8605b115-7af7-4471-9ed6-269740bb4ad6",
        "Type": "usercreated",
        "Title": "Поварское наказание",
        "Location": "LOCATION_PARIS",
        "PublicId": "102922546691",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Paris/_scene_paris.entity",
        "TileImage": "$($repository 6f592c07-601b-4574-ba39-f6d397ba1a10).Image",
        "Description": "Здравствуй 47-й, мир утопает в французкой кулинарии и этому нету пути. Каждый день повара со всей страны обьединяются в одну единую поварскую банду где они творят всё.\rНаши цели это Шеф-повара из показа мод Sanguine. Они являются третьими по списку лидеров по приготовлении мясо.\rНо клиент утверждает о том что их мясо это остатки Трупов некоторые из которых были недавно завезены.\rЭтот каннибализм помогает директору сохранять большой доход ни потратив ни копейки на изыссканое мясо.\rУдачи 47-й.",
        "GameVersion": "8.23.0.0",
