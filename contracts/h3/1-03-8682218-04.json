    "Metadata": {
        "Id": "ded5a84a-e776-4dbd-ad64-4cf13903aa15",
        "Type": "usercreated",
        "Title": "The Bakery Blackout",
        "Location": "LOCATION_COASTALTOWN",
        "PublicId": "103868221804",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_octopus.entity",
        "TileImage": "$($repository aa93bf2b-558d-4418-b54c-2d1858e301ad).Image",
        "Description": "Our client, a local bakery, has discovered that the staff at the Caruso mansion have been smuggling narcotics and other small contraband through homemade muffins. We have been hired not only to stop the illegal activity, but to send a message to any other chefs that would consider joining the mansion&apos;s operation. Have you brushed up on your baking skills, 47?",
