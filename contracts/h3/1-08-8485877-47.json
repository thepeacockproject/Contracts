    "Metadata": {
        "Id": "fd1a119d-fa4b-4c0a-9d3c-d2cacd9d54f1",
        "Type": "usercreated",
        "Title": "Let me AXE you a question...",
        "Location": "LOCATION_BANGKOK",
        "PublicId": "108848587747",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Bangkok/_scene_tiger.entity",
        "TileImage": "$($repository ba02f271-f256-41d7-97cc-c0a36e5db1e7).Image",
        "Description": "You are a member of the hotel staff working at the Himmapan Hotel in Bangkok. Ever since you were a child, you wanted to be a fire fighter, but your fear of fire kept you out of the profession. You&apos;ve never really been appreciated while working at the hotel, and this last paycheck wasn&apos;t enough to cover your power bill. Ontop of all that, this day has been very stressful, and seeing that fireman&apos;s axe made something in you snap... It&apos;s time to get revenge on your co-workers.",
