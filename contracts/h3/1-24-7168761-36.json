    "Metadata": {
        "Id": "552472c7-cbdf-49c9-96dd-b0dc4768ec78",
        "Type": "usercreated",
        "Title": "Hostile takeover: Five vacancies",
        "Location": "LOCATION_GREEDY_RACCOON",
        "PublicId": "124716876136",
        "ScenePath": "assembly:/_pro/scenes/missions/Greedy/mission_raccoon/scene_raccoon_basic.entity",
        "TileImage": "$($repository c7faa8bd-7de3-494b-840b-8ab812e36ef9).Image",
        "Description": "Good evening, 47.\rA new contract has been issued. Our client is the shadow network of arms suppliers who aided us during our &quot;freelancing journey&quot;. Elimiate the targets outlined in the document, so that the Milton-Fitzpatrick would have 5 new job openings across the different levels, which our client would fill with their undercover arms dealers and intel brokers.\r(For an additional challenge, only use the default loadout: ICA19, fiber wire, 3x coins).",
        "GameVersion": "8.24.0.0",
        "IsPublished": true,
        "Entitlements": [
