    "Metadata": {
        "Id": "e5ca1fe6-3d17-4566-83b1-7dcf8fb40a1f",
        "Type": "usercreated",
        "Title": "The Revenge of Sean Rose",
        "Location": "LOCATION_NEWZEALAND",
        "PublicId": "120434466689",
        "ScenePath": "assembly:/_pro/scenes/missions/sheep/scene_sheep.entity",
        "TileImage": "$($repository 77fea61d-7993-486c-a5d5-71a6e55d414c).Image",
        "Description": "You are Sean Rose. Lieutenant of the Freedom Fighters, and Pristine Army commander. But we all die someday. Your&apos;s just happened to be sooner, rather than later. But as a man with such high honors, you will not allow your dignity to be soiled as much as it has. Your militia was disbanded, its leader long dead. And now you&apos;ve learned that your beloved wife has met a new man, a Providence shill by the name of Orson Wells. You will not let him blight your reputation, will you?",
        "GameVersion": "8.3.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_NEWZEALAND"
        ],
