    "Metadata": {
        "Id": "175f687a-7130-4ac5-b926-99559f02d377",
        "Type": "usercreated",
        "Title": "Sapienza bombing",
        "Location": "LOCATION_COASTALTOWN",
        "PublicId": "103463660751",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_octopus.entity",
        "TileImage": "$($repository c823beec-3d73-47b6-87d9-076c384c4662).Image",
        "Description": "Silvio Caruso and his lab team have discovered how to turn corpses into zombies. Caruso has sent his senior laboratory technician, Viana Buccho, to strike a deal with Padre Francesco, to give them all the corpses to be buried by the Church, to make more zombies. The first zombie, Umberto Megazzini, is already living amongst humans, just waiting for there to be enough of its kind to take over Sapienza. Until then, it must wear a mask covering its entire face so no one realises it is a zombie.",
