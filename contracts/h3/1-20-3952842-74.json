    "Metadata": {
        "Id": "f5e5af0b-b0c9-4243-af06-6f40cd3246ac",
        "Type": "usercreated",
        "Title": "The Revival (Sniper Assassin 2 Vol. 1)",
        "Location": "LOCATION_NEWZEALAND",
        "PublicId": "120395284274",
        "ScenePath": "assembly:/_pro/scenes/missions/sheep/scene_sheep.entity",
        "TileImage": "$($repository c8c6979e-2b8b-48cc-b405-7f1138b88e8c).Image",
        "Description": "3 years since the last attempted attack by TTR some sources says the revival is here. Another high-ranking member that didn&apos;t go to the mass murder in Japan. We reached out to our former client. No response. We have been instructed by the board to investigate a remote island in New Zeland. We have reason to believe TTR is using this as a base of operations. If this is true we have 5 targets to take out with a sniper. Good luck \r\rSTART IN OFFICE AND GO TO THE ROOF TO SNIPER (if avaliable)",
        "GameVersion": "8.4.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_NEWZEALAND"
        ],
