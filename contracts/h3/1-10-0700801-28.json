    "Metadata": {
        "Id": "38968b8e-74d5-4b69-a672-43052c2e7d85",
        "Type": "usercreated",
        "Title": "Accidents can happen in a Hospital",
        "Location": "LOCATION_HOKKAIDO",
        "PublicId": "110070080128",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/_scene_snowcrane.entity",
        "TileImage": "$($repository 24d04ef3-62aa-4b79-bb8e-24ae034ab93f).Image",
        "Description": "This hospital has had some serious allegations against it for unsanitary and unsafe practices. Through legal loopholes however, the board has been able to avoid lawsuits through rather unsavory practices. Our client, an annonymous doctor currently employed at this facility, is asking us to preform 5 &quot;accidental&quot; deaths in one go to tarnish the reputation of this hospital and settle some personal scores with the higher ups. This will send a clear message to all who think they are above the law",
        "GameVersion": "8.18.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_HOKKAIDO"
