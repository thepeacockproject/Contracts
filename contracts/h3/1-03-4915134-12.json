    "Metadata": {
        "Id": "fbac3ab6-e72d-498a-b924-7c5299eb8c78",
        "Type": "usercreated",
        "Title": "Super Saltatore Odyssey",
        "Location": "LOCATION_COASTALTOWN",
        "PublicId": "103491513412",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_octopus.entity",
        "TileImage": "$($repository b6527741-a551-4d91-a423-fb8325801994).Image",
        "Description": "Our client is local crime boss Bowsero Koopalini. Brothers Mario and Luigi Saltatore have uncovered his hidden stashes of stolen gold coins and &apos;magic&apos; mushrooms, and are turning evidence over to the authorities. Worse, big-band-singer-turned-mayoral-candidate Silvia Masullo vows to crush organized crime in Sapienza. She is backed by her friend, visiting princess Celestina de Francesco. Koopalini wants all four gone once and for all. Anything to protect his little mushroom kingdom, eh, 47?",
