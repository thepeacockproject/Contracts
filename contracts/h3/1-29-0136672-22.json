    "Metadata": {
        "Id": "ed6e9cd8-fa56-40f1-88a1-c52c11f034c6",
        "Type": "usercreated",
        "Title": "German Pretzel Delivery",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129013667222",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository bf185f2f-17c7-414c-b237-6b2cc8a13b69).Image",
        "Description": "Hi Tobias,\r\rIt&apos;s been 46 times now that this group has ordered pretzels from our bakery (delivery through the IC-eAts app), and not once have they left a tip. They&apos;ve also left two-star reviews and made fake complaints to extort partial refunds... yet they keep ordering.\r\rIf this continues, we will be soon out of business. Please make this delivery as professional as possible so that our customers are finally satisfied.\r\rBest regards,\rKruger Bakes Management",
        "GameVersion": "8.24.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_EDGY"
        ],
