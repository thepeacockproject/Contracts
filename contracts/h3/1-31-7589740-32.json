    "Metadata": {
        "Id": "d8be2637-0af6-4b7e-9a2d-97a203a6b014",
        "Type": "usercreated",
        "Title": "Eliminate the cheese thief.",
        "Location": "LOCATION_ELEGANT_LLAMA",
        "PublicId": "131758974032",
        "ScenePath": "assembly:/_pro/scenes/missions/elegant/scene_llama.entity",
        "TileImage": "$($repository ef4d0343-bb8f-4432-9868-2ff7835e7969).Image",
        "Description": "At some point last night somebody stole Mr Davide&apos;s cheese from the staff fridge. It was a gift from his mother and was clearly labelled. This isn&apos;t the first time that the cheese thief has struck, but Luciano has asked us to make sure it will be the last.\r\rUpon checking the security tapes, it was either Jerico or Pablo who committed this foul crime, we cannot be certain who, so both must die. \r\rIt may seem unorthodox to eliminate them both, but we cannot let crimes against dairy go unpunished.",
