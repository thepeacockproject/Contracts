    "Metadata": {
        "Id": "ed50db68-5b4a-4460-867f-e18ee1c11663",
        "Type": "usercreated",
        "Title": "THE LAID-BACK LIQUIDATION",
        "Location": "LOCATION_ANCESTRAL_SMOOTHSNAKE",
        "PublicId": "133683220988",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_smoothsnake.entity",
        "TileImage": "$($repository 20bed705-9f0f-4a3e-ad07-2a7ef3938868).Image",
        "Description": "&quot;M-morning Mister. You&apos;ve been working yourself so hard, why don&apos;t you take a break? After this contract of course. I wanted to take part in the Dartmoor garden show, its my little passion, but some rivals got my invite cancelled. Take care of them, but be quiet. We don&apos;t want to disturb anyone napping. Good luck! I&apos;m gonna... go back to sleep.&quot; (This is not my work. All credits go to a user by the name of RobotEngie who allowed me to turn these contracts into steam form from xbox format.)",
        "GameVersion": "8.12.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_ANCESTRAL"
        ],
        "CreatorUserId": "6dea2cec-af14-4723-b569-6274169e648d",
        "ServerVersion": "8.12.0.56",
        "CreationTimestamp": "2023-06-14T10:34:18.8164968Z",
