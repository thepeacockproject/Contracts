    "Metadata": {
        "Id": "1bd7fdfb-87d7-48f4-90bd-5a14865e6f1f",
        "Type": "usercreated",
        "Title": "Cry Me a River",
        "Location": "LOCATION_WET_RAT",
        "PublicId": "130124384643",
        "ScenePath": "assembly:/_pro/scenes/missions/wet/scene_rat_basic.entity",
        "TileImage": "$($repository 5d40b48f-25f3-430b-bb07-31514345c627).Image",
        "Description": "Good evening. Our client is a devoted fisherman who works along the Yangtze river. Recently, the targets have harassed him as a part of what the client believes is a series of disruptions designed to ruin his career. The final straw was when the targets set up a coin trail, and as he followed the trail he slipped on a banana and fell in the river. He wants revenge. All requested weapons can be found in the facility armoury. It may be overkill, but we can&apos;t go against our client&apos;s request.",
