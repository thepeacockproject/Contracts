    "Metadata": {
        "Id": "e3d4fb77-dddb-4734-89b8-4d44a2328f46",
        "Type": "usercreated",
        "Title": "The Laundry Protocol",
        "Location": "LOCATION_BANGKOK",
        "PublicId": "108899087808",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Bangkok/_scene_tiger.entity",
        "TileImage": "$($repository 68761172-9512-4e2d-be0a-63df23317d6d).Image",
        "Description": "Good Day 47,\rThe laundry staff at this hotel have been remarkably efficient. Too efficient, perhaps. Security has also taken an unusual interest in keeping things clean.\rYour task is simple: remove the personnel responsible for both washing and guarding the premises. No stains, no witnesses and preferably no questions. Consider this a routine sanitation exercise.\r\rThe ICA has provided the list. You provide the final rinse.\r\rGood luck.\r\rBy - SW",
        "GameVersion": "8.25.0.94",
