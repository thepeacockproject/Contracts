    "Metadata": {
        "Id": "9f47d606-c241-43d2-8b18-449caa88310a",
        "Type": "usercreated",
        "Title": "Ach das hab ich ja auch noch",
        "Location": "LOCATION_ANCESTRAL_BULLDOG",
        "PublicId": "128127657733",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_bulldog.entity",
        "TileImage": "$($repository d2e845c3-6817-485d-801b-449a0eb3d8c9).Image",
        "Description": "Da wandere ich doch soeben durch meinen Achtwohnsitz, und siehe da?\rEin Bild meines längst vergessenen Häuschens in dem britischen Hinterland...\rDieser heruntergekommene Altbau, quasi ein ... Schuhkarton könnte man sagen Ah-Ha-Haa... Ist mein Humor nicht köstlich?\r\rJa nicht einmal meinen Hund würde ich in so einem kleinen Häuschen nächtigen lassen, da kann mich sich ja nicht blicken lassen, das wirkt ja fast schon.... bürgerlich...\r\rNun, fangen wir einmal damit an, dort aufzuräumen.",
        "GameVersion": "8.25.0.0",
        "IsPublished": true,
