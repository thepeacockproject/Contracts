    "Metadata": {
        "Id": "e499491b-1409-4d4c-aad0-bdebb7eb9227",
        "Type": "usercreated",
        "Title": "[The Eighth Protocol] The Intercept",
        "Location": "LOCATION_NORTHSEA",
        "PublicId": "121255834947",
        "ScenePath": "assembly:/_pro/scenes/missions/theark/scene_magpie.entity",
        "TileImage": "$($repository deb93f61-a6c2-4691-8524-1353510483c4).Image",
        "Description": "Good evening, 47. Injecting the serum into Arthur Edwards was a terrible mistake.\rYou thought you erased him. Instead, you scattered his mind and gave it time to grow.\rIn Chongqing, they built a clone. And they filled it with him. His memories. His hunger. His spite.\rNow the clone is on the island, wearing the face of Jason Portman.\rThe clone is one floor below. The original is waiting above. By the time you read this — that distance is shrinking.\rDo not let them meet each other.\r\r(Start at Bar)",
        "GameVersion": "8.23.0.0",
