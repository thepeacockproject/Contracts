    "Metadata": {
        "Id": "107e0fe9-db9e-4bbd-99da-5d480fd77c37",
        "Type": "usercreated",
        "Title": "Time Theft",
        "Location": "LOCATION_BANGKOK_ZIKA",
        "PublicId": "116220040902",
        "ScenePath": "assembly:/_pro/scenes/missions/Bangkok/scene_zika.entity",
        "TileImage": "$($repository 6098411b-1b38-45d8-b762-498a98f4bab2).Image",
        "Description": "47, our client is concerned with slimming the payroll margins of the staff at the Himmapan Hotel. Who need this much staff, at this hour? What are some of these guys even doing? Time for these slackers to drop their mops and clock out - permanently. Time theft is a real threat to corporate livelihood.\r\rDon&apos;t loaf around while you&apos;re fulfilling this contract, 47. Anything less than your quickest completion is liable to be construed as time theft.",
        "GameVersion": "8.23.0.0",
        "IsPublished": true,
        "Entitlements": [
