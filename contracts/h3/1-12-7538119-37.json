    "Metadata": {
        "Id": "8fef434d-e2f1-47e4-ab49-d092daafa1de",
        "Type": "usercreated",
        "Title": "Delgado Decimation",
        "Location": "LOCATION_COLOMBIA",
        "PublicId": "112753811937",
        "ScenePath": "assembly:/_pro/scenes/missions/colombia/scene_hippo.entity",
        "TileImage": "$($repository 31a7f159-0652-45af-8f12-fee957f3cdeb).Image",
        "Description": "Rico Delgado&apos;s workers have been slouching a lot lately. Time theft is still theft, and you don&apos;t steal from the Cartel. Rico came up with a creative solution in order to discipline all the workers as a collective without rendering them severely understaffed - decimation. He assembled all 50 of his workers and ordered his head of security to put them all on a list. Every 10th man on the list was sentenced to death. Except one mansion guard did not even show up, so he was sentenced by default",
