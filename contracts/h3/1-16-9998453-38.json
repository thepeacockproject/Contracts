    "Metadata": {
        "Id": "9afaaa64-50f9-4460-ab5d-4a6029ab2235",
        "Type": "usercreated",
        "Title": "Youth in Asia II - The Boxing Bias",
        "Location": "LOCATION_BANGKOK_ZIKA",
        "PublicId": "116999845338",
        "ScenePath": "assembly:/_pro/scenes/missions/Bangkok/scene_zika.entity",
        "TileImage": "$($repository aac21798-b757-4c27-ba59-6047acdfe928).Image",
        "Description": "Our client hates boxing, finding it tedious, redundant, and obnoxious. Your targets are three boxing promoters and former pugilists. Effects of past head trauma have led each to some self-destructive behaviors, such as joining a death cult, for example. They are still active in the sport, however, and continue to promote boxing, sacrificing their clients’ health for the cause of spectacle. It would be sending a mixed message if you knocked anyone out, but you are the expert, 47. Ring the bell.",
