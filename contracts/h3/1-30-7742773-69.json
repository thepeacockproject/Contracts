    "Metadata": {
        "Id": "1c5205a2-6375-4939-8c37-78417faf7bfe",
        "Type": "usercreated",
        "Title": "Rain Remembers",
        "Location": "LOCATION_WET_RAT",
        "PublicId": "130774277369",
        "ScenePath": "assembly:/_pro/scenes/missions/wet/scene_rat_basic.entity",
        "TileImage": "$($repository 47424c02-bb0f-4066-af5a-f1cdcdcd08b2).Image",
        "Description": "They say Chongqing remembers certain nights before they happen.\rThree strangers. One rainy evening.\r\rThree deaths people will call accidents—faulty railings, bad timing, the city swallowing another careless soul.\r\rThe third won’t be so easy to explain.\rSteel, close and deliberate.\r\rSome swear this story already happened once.\r\rTonight, we make sure the memory becomes real.",
        "GameVersion": "8.23.0.0",
