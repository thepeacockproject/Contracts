    "Metadata": {
        "Id": "a8b4660a-f845-4b0b-9a5d-0a454b510006",
        "Type": "usercreated",
        "Title": "The Miami Race Murders",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111549589273",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository a95a560f-963f-4fba-aa0d-e0c554a13988).Image",
        "Description": "On the 12th of February, 2026, four people went mysteriously missing at the Krondstadt race in Miami. Over the course of the day, two large bangs were heard near where the employees were stationed, and evidence indicated explosions, however no bodies were ever found and there was no evidence of any perpetrator on the CCTV. This is truly a curious case.",
