    "Metadata": {
        "Id": "63f0def6-9d25-4ab2-948a-a7a8482b57dd",
        "Type": "usercreated",
        "Title": "The Smith Icing",
        "Location": "LOCATION_HOKKAIDO",
        "PublicId": "110772619445",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/_scene_snowcrane.entity",
        "TileImage": "$($repository f19cb43e-7f33-4d27-aa42-ecd7918eb2fe).Image",
        "Description": "47,\r\rThis may be a difficult one. Our &quot;friend&quot;, Agent Smith, was captured during his investigation into organ harvesting. We know he has already been interrogated, and considering his knowledge of you, this may very well compromise our mission in Hokkaido. \r\rGAMA&apos;s Doctor Ito and his research aide Doctor Kurosawa would have handled this, possibly using similar techniques to Ito&apos;s own treatments. \r\rAll three need to be removed, 47. Cleany, quietly, no evidence left. \r\rI&apos;m sorry.",
        "GameVersion": "8.12.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_HOKKAIDO"
        ],
