    "Metadata": {
        "Id": "0247fd3b-74b6-4ffa-add5-7e8d757e47e8",
        "Type": "usercreated",
        "Title": "Phantom of the Orchestra",
        "Location": "LOCATION_NORTHSEA",
        "PublicId": "121165585073",
        "ScenePath": "assembly:/_pro/scenes/missions/theark/scene_magpie.entity",
        "TileImage": "$($repository 29a8f83b-8c0d-4f45-a104-0c848b4ca2b6).Image",
        "Description": "Good Evening, 47\r\rICA have dug up an interesting contract for you.  It is the evening of the annual Ark Society gathering. Unfortunately, their blindfolded musicians aren&apos;t as innocent as they look. \r\rYour targets consist of Axel Phenniger, The Ceremony Master. And two of the Societies musicians.\r\rYour role here is to sned a message to the society. ICA is watching.\r\rWhy not get a little theatrical in your methods and disguises. You&apos;ve earned it, 47. Have fun, I shall leave you to prepare.",
        "GameVersion": "8.23.0.0",
