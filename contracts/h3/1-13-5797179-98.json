    "Metadata": {
        "Id": "0c50f219-cd91-4c95-9543-953219266ec4",
        "Type": "usercreated",
        "Title": "The mysterious Client EP 1",
        "Location": "LOCATION_MUMBAI",
        "PublicId": "113579717998",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Mumbai/scene_mongoose.entity",
        "TileImage": "$($repository e96d830c-868b-4cfe-a5f6-0446326237d7).Image",
        "Description": "Good evening 47. A new client only known as The Writer has issued a wierd but well paying contract. Your mission is to kill your four targets with a barber razor while disguised as the barber. Our client is willing to pay extra if the bodies are left at the spot they are killed so &quot;they will be more news worthy&quot; (quoted by The Writer) They DONT want you to hide them as that wont make for as good a story as they would like.\r\rGood luck 47\r\rPay: 25000 Dollars Pr kill\rExtra pay: 30000 Dollars",
