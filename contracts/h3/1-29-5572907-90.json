    "Metadata": {
        "Id": "b83015b2-dd5c-4643-ab1d-6494fe10cce9",
        "Type": "usercreated",
        "Title": "Bag of Tricks",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129557290790",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository 9d47d847-c2dc-4f6d-b0e9-6d719560418e).Image",
        "Description": "Good evening 47,\r\rYour target is Agent Thames, also know as &quot;The Professional&quot;, a reserved yet snarky ICA agent.\rThe ICA is currently operating in Berlin, he is planning to betray his fellow agents  and finish the mission by himself.\rHe sat up a small team with some of his old friends at the nightclub, the ICA wants you to eliminate him and his team.\rHe already killed another agent by dropping a bag of bricks on him.\rI&apos;m sure you love some poetic justice, 47, you know what to do.\r\rGood Luck.",
