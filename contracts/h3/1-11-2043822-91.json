    "Metadata": {
        "Id": "f3a5aff1-09b2-4067-b857-b1d905bf65bd",
        "Type": "usercreated",
        "Title": "Распорядительное убийство",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111204382291",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 6105f0a4-6169-48f3-9e54-764cf4ec991b).Image",
        "Description": "Здравствуй 47-й, ты отправляешься в Майами где твои главные цели- команда распорядителей гонок, недавно по нашим расчетам и системы слежения мы заметили что команда Распорядителей готовится устроить массовую поломку спорт Болидов тем самым полностью отменить гонку и забрать некие документы и отчеты. \r\rНаше агенство хочет чтобы ты замаскировался в них и убил их до того как они сорвут всю гонку. \r\rУдачи 47-й.",
        "GameVersion": "8.25.0.0",
