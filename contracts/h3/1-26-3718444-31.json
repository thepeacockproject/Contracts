    "Metadata": {
        "Id": "4e9e34c2-5a2e-4f53-b3eb-2ecd2e1d0cf1",
        "Type": "usercreated",
        "Title": "Propane &amp; Propane Accessories to Murder",
        "Location": "LOCATION_OPULENT_STINGRAY",
        "PublicId": "126371844431",
        "ScenePath": "assembly:/_pro/scenes/missions/Opulent/mission_stingray/scene_stingray_basic.entity",
        "TileImage": "$($repository ebad48b0-50bb-443a-ab07-96d8c9d56b51).Image",
        "Description": "Our Client, Mr. Hill, as discovered that a major coal baron has hired a team of mercinaries to sabotage Mr. Hill&apos;s supply chain, which would ruin his business of promoting what he considers clean(er) heating and cooking fuels. They cannot be permitted to succede, but Mr. Hill does not want to raise suspicions as to his involvement or that he has an informant imbedded in his competition&apos;s organization. It would seem that the solution to pollution is, in fact, you afterall, 47. Good Luck.",
        "GameVersion": "8.8.0.0",
        "IsPublished": true,
        "Entitlements": [
