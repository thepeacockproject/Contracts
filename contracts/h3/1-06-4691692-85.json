    "Metadata": {
        "Id": "f7f111d6-77e5-49be-a832-b4092523e381",
        "Type": "usercreated",
        "Title": "The Fortune Teller&apos;s Magnum Opus",
        "Location": "LOCATION_MARRAKECH",
        "PublicId": "106469169285",
        "ScenePath": "assembly:/_pro/scenes/missions/marrakesh/_scene_spider.entity",
        "TileImage": "$($repository f5ecade6-1a58-44d1-a457-7688746a988d).Image",
        "Description": "Good evening 47. The local fortune teller is tired of being labeled as a fraud and has proclaimed that five citizens of Marrakesh will mysteriously die in the span of one hour.  He asks that we make certain that his prediction be believed by causing five residents, including himself, to be killed in accidents to allow for him to not only make a correct prediction, but also get the last laugh over the people of Marrakesh for driving him into poverty.",
        "GameVersion": "8.24.0.0",
        "IsPublished": true,
        "Entitlements": [
