        "ScenePath": "assembly:/_PRO/Scenes/Missions/Mumbai/scene_mongoose.entity",
        "TileImage": "$($repository 80051c02-e026-40fe-970a-7b7aaa62302c).Image",
        "Description": "Another contract has been issued by our ex military friend 47. \r\rIts listed here that his son, a painter, is being targeted by an assassin going by the alias of the Kashmirian. Our client has hired you to stop the assassin before he kills his son and take out the small team of men.\r\rYet more men that have wronged our client in the past and are now reaping the rewards with high ranking military positions offering high pay and now they are trying to tie loose ends. We will first.\r\rGoodluck 47.",
        "GameVersion": "8.24.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_MUMBAI"
        ],
        "CreatorUserId": "4ec77ed3-19da-4392-a4be-9dd444ae7dc4",
