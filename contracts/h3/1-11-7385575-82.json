    "Metadata": {
        "Id": "a037f2a2-59ab-4666-93de-a8f4c6477ab3",
        "Type": "usercreated",
        "Title": "The Emancipation Offishiation",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111738557582",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 5572e2eb-5084-4bb3-bb64-6fc154d106da).Image",
        "Description": "Greetings, 47.\r\rThis contract is a rescue mission. Four of our agents are being held captive in Kronstadt HQ. Three are diplomats working to establishing maritime relations for the ICA. They are being held in tanks 6, 7, and 14, respectively.\r\rThe fourth is their bodyguard; a master combatant who has vital intel on how to eliminate the head of the private military group who captured them. He is being held in tank 12.\r\rWe take care of our own, 47. Find them, free them, and escort them to safety.",
        "GameVersion": "8.12.0.0",
