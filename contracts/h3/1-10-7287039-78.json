    "Metadata": {
        "Id": "62e09efb-c040-4c77-9883-cffaaa89b98a",
        "Type": "usercreated",
        "Title": "The Highwayman",
        "Location": "LOCATION_HOKKAIDO",
        "PublicId": "110728703978",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/_scene_snowcrane.entity",
        "TileImage": "$($repository 8e78f7a2-5def-4d32-aae6-001cb76a4d7f).Image",
        "Description": "He came from where the winds never change, \rHes filled with rage, like a firing range.\r\rThe moon is bright, the streets are narrow,\rHe sweeps through the air, like a pointy arrow.\r\rHis dress, the stress, he carries with him,\rThat liar, the fire, thats burning within.\r\rStill seeking that person who once was a fan,\rIn the dark, a spark, well maybe he can..\r\rHe will avenge the túrós man,\r\rCuz he is Ben,\rthe Highwayman.",
