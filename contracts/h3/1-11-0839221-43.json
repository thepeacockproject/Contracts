    "Metadata": {
        "Id": "72acfad6-57fb-4b8c-bdfa-3589415d7812",
        "Type": "usercreated",
        "Title": "An inside job - Part I",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111083922143",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository ca1e11d8-8a96-45f0-a70f-fcdc0a859888).Image",
        "Description": "CREATORS NOTE: Default start or Dolphin Start and start with coins only.\r\rBRIEFING:\r47, someone is giving away valuable intel of our operations. We are trying to trace them. We identified 4 targets who are currently in Miami who might know something. Observe them and eliminate them. Report your findings. Since you are already in Miami that should not be a problem for you. But we have to act fast so we can not provide any utility. But you know the place. It should be easy for you to get it done.",
