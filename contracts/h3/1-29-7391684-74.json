    "Metadata": {
        "Id": "a604776b-4ffb-485e-8ea7-abdc3dd593ac",
        "Type": "usercreated",
        "Title": "The show WON&apos;T go on.",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129739168474",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository d2a76a28-aa09-4f7a-9dc7-49679a0db226).Image",
        "Description": "47, \rA new contract has appeared.\rDeal with it ASAP, Your location is a nighclub in Berlin. The show is funded by the mob, some of their &quot;partners&quot; active at the nightclub.\r\rEliminate the targets within 15 minutes and avoid collateral damage.\r\rCOMPLICATIONS:\r1. Eliminate all targets by snapping their neck.\r2. Do it all in your suit.\r3. Do not get spotted.\r4. Obtain 5 screwdrivers before leaving the club.\r\rMaide by: SomeGuyNamedTimo",
