    "Metadata": {
        "Id": "be5ac003-1832-47b6-bcd3-90c1893f2f0b",
        "Type": "usercreated",
        "Title": "Loud and Lavish Laundry",
        "Location": "LOCATION_MUMBAI",
        "PublicId": "113458217169",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Mumbai/scene_mongoose.entity",
        "TileImage": "$($repository f51170ff-0dc6-417e-a208-8e27fcced3dd).Image",
        "Description": "Agent 47 has always been know to help out the workers that are being surpressed by the people that exploit their services. In Mumbai, the wealth gap between the rich and the poor is simply gigantic. The laundry workers are being put through the wringer every day. Agent 47 used to work at the particular place that&apos;s now a living hell. Time to bring the foreman, his top aid,  and the man behind these exploits, The Kasmirian, to justice. Make the workers&apos; point loud and clear!",
