    "Metadata": {
        "Id": "f6b97d38-e78f-4846-878e-0c1571f1f2be",
        "Type": "usercreated",
        "Title": "Lines of Allegiance",
        "Location": "LOCATION_ROCKY_DUGONG",
        "PublicId": "134293760500",
        "ScenePath": "assembly:/_pro/scenes/missions/Rocky/scene_dugong.entity",
        "TileImage": "$($repository 5fd9ac67-4532-4163-aa61-b371c899ab8d).Image",
        "Description": "Good evening, 47.\n\nOur client has identified a small network operating on Ambrose Island. Despite their differing appearances and affiliations, these five individuals are connected through a series of illicit dealings that threaten the fragile balance of power in the region.\n\nTwo militia soldiers maintain security and communications. Two pirates oversee transportation and enforcement. A welder, seemingly insignificant, serves as a critical intermediary between both groups.\n\nThe client requires all five to be eliminated. Particular attention should be paid to appearances—some targets are expected to meet their end while dressed as militia soldiers, while others are to remain in their usual attire. The exact requirements have been provided in your contract.\n\nGood luck, 47.",
        "GameVersion": "8.24.0.90",
        "IsPublished": true,
