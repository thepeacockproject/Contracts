    "Metadata": {
        "Id": "7b7fb413-3fc5-4145-af7e-27761d2fe8f3",
        "Type": "usercreated",
        "Title": "The Davenport Dismissal",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129849278722",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository 9c4cc4ef-3242-467a-9753-d998ad22a344).Image",
        "Description": "Good Evening 47, \r\rICA have recieved an... odd contract for you. Former ICA Agent Davenport has been spotted at large in Berlin. The weirdly specific contract here wants you to take care of him while disguised as the boss, Hirschmuller. I suppose you&apos;ll be firing him yourself, 47.\r\rICA wants us to cause no harm to those around, including pacification, so you&apos;ll need to take out the Boss too. Don&apos;t worry, he&apos;s not exactly innocent himself.\r\r&quot;Kill your targets and find the eggs-it&quot; \rit says...",
