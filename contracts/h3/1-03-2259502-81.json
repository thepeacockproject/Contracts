    "Metadata": {
        "Id": "d1f0ca41-6ff8-435a-b8dc-698c01c4af36",
        "Type": "usercreated",
        "Title": "The Trafficking Scheme At Sapienza",
        "Location": "LOCATION_COASTALTOWN",
        "PublicId": "103225950281",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_octopus.entity",
        "TileImage": "$($repository c69d9281-28cd-4aeb-a4f4-ab1e8b25c823).Image",
        "Description": "Good afternoon, 47.\rThis should be a relatively simple job.\rYou have five targets. I&apos;d advise eliminating three from the tower central to Sapienza via a sniper rifle.\rIntel shows that these targets are all part of one trafficking scheme in the Italian underworld, with Silvia Masullo being the face of operations, and Doctor Lafayette orchestrating the overall organisation. They are arranging to meet. Eliminate them and we might see a better tomorrow.\rGood luck, 47. I will leave you to prepare.",
        "GameVersion": "8.26.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_COASTALTOWN"
        ],
