    "Metadata": {
        "Id": "97a7bd8c-376e-4e54-b0b4-bfb75f5bedef",
        "Type": "usercreated",
        "Title": "Poisoned Image",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129599028904",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository 8b29da09-461f-44d7-9042-d4fde829b9f2).Image",
        "Description": "47,\r\rWith the release of the data files (and that snafu in South Dakota a few years ago), the ICA has been having a public image problem.\r\rMuch blame rests on Agent Montgomery &amp; 4 members of the squad under his command. We need to eliminate them, but it has to be completely untraceable. Absolutely no blowback on the ICA.\r\rYou must be a complete ghost for this mission. No traces of any kind. Use poison. Do not harm anybody else. Do not steal anybody&apos;s clothing. Do not leave any witnesses.\r\r-Diana",
        "GameVersion": "8.1.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_EDGY"
        ],
