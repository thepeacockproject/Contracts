    "Metadata": {
        "Id": "cd3c89a7-1873-4252-84b0-bb5b40bd6336",
        "Type": "usercreated",
        "Title": "Deadly Rivals 39: Mopping Up",
        "Location": "LOCATION_ANCESTRAL_BULLDOG",
        "PublicId": "128852216103",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_bulldog.entity",
        "TileImage": "$($repository 0f88cdaa-d784-4951-8696-ea3065cc6228).Image",
        "Description": "Good afternoon, 47.\r\rThe Board has authorized a pro bono mission today, given the embarassment these four have caused the ICA, as some of the last remnants of Klaus&apos; ressurection gang.\r\rMr. Ford was a protege of the late Salvatore Bravuomo, who whipped up new identities for previously deceased clients, and is bringing the gang back together with a photographer, investigator, and undertaker to provide fake funeral services.\r\rWe cannot let this happen again 47.\r\rPut a stop to it.",
        "GameVersion": "8.25.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_ANCESTRAL"
        ],
        "CreatorUserId": "366d1a87-f857-46e4-b652-69bd2fb30d38",
        "ServerVersion": "8.25.0.94",
        "CreationTimestamp": "2026-09-21T19:00:23.0208172Z",
