    "Metadata": {
        "Id": "1700a017-f427-4113-a0dc-048e52b79ec6",
        "Type": "usercreated",
        "Title": "El Gancho Torcido, The Crooked Hook",
        "Location": "LOCATION_COLOMBIA",
        "PublicId": "112013383772",
        "ScenePath": "assembly:/_pro/scenes/missions/colombia/scene_hippo.entity",
        "TileImage": "$($repository 0c9b4645-53d0-4f15-96f9-0f3d50c5e970).Image",
        "Description": "The La Carne cult&apos;s activity has come to a halt thanks to your excellent assassinations. However, the cult is bigger than just the Italian town it started in. Your next stop is Santa Fortuna, where a sect of the cult also named La Carne, have infiltrated the Delgado cartel. Their agents have been spread throughout the town, each one having built up significant influence unnoticed. There&apos;s a local tale about a crooked hook that tears apart evildoers, you should give the cult a special retelling.",
