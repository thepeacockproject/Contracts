    "Metadata": {
        "Id": "6f6cb82f-90d0-4f48-92b3-0bb15402df0c",
        "Type": "usercreated",
        "Title": "Hexecution of La Bruja",
        "Location": "LOCATION_ELEGANT_LLAMA",
        "PublicId": "131519038884",
        "ScenePath": "assembly:/_pro/scenes/missions/elegant/scene_llama.entity",
        "TileImage": "$($repository c76452de-4e87-463e-92f6-42a442669202).Image",
        "Description": "For centuries, the Coven of Brujas has ruled from the shadows, its Brujería sorceresses shaping history through magic and manipulation. Their power has toppled governments, swayed leaders, and ensured their survival while the world remains blind to their influence. Now, Valentina Yates and her twin sisters, Violetta, and Madalena, continue their legacy. But their final safeguard, Leonides, must also fall. He alone holds the key to their resurrection. End the coven, 47.\r\rCreated by ChRoNiCSmK305",
