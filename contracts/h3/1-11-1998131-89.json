    "Metadata": {
        "Id": "c99188eb-3ffc-44a9-b12a-0e31768c3c5d",
        "Type": "usercreated",
        "Title": "The Negerboll Destabilization",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111199813189",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository dc86d9ba-5c13-41ed-931d-92625a565707).Image",
        "Description": "Greetings, 47. Your destination is a pier in Miami, Florida, where several  assassinations have taken place, all of which have been traced back to Nicholas Velmorral having sold low-quality Negerboll. Our client, Robert Knox, has asked us to publicly dispose of both Nicholas and his security team, consisting of Francois Ricot, Jack Baxter, and Luke Brenton, who have prevented health inspectors from closing his business with its non-code-compliant hygiene practices. I will leave you to prepare.",
        "GameVersion": "8.12.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_MIAMI"
        ],
        "CreatorUserId": "a3b23e61-adb4-4f26-8cca-94de2e6f61fe",
