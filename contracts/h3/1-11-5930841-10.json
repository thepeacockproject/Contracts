    "Metadata": {
        "Id": "cf7af9fd-d747-473b-80ee-f4745709ce03",
        "Type": "usercreated",
        "Title": "Even the Odds",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111593084110",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository ecc907c9-5e40-4bc2-b492-9bef5c49cd64).Image",
        "Description": "Mischief is afoot! The race has been rigged by Kronstadt Industries to give Sierra Knox the win, and 3 key personnel are in on it! The Head Doctor ensured the other racers wouldn&apos;t be in top shape, while the Head Race Marshal plans to disqualify racers whenever he can get away with it. The lead mechanic of Sierra&apos;s team is even in on it, and has given the car an illegal octane booster.\r\rOur client, Moses Lee, has learned of this deception and wants the perpetrators to be stopped... violently.",
        "GameVersion": "8.10.0.0",
