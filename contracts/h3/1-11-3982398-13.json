    "Metadata": {
        "Id": "b93a8b5c-7faa-453e-9cc0-0b6285a97244",
        "Type": "usercreated",
        "Title": "A False Sense of Security",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111398239813",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 842298b3-58f8-41cd-9779-84eee28336bf).Image",
        "Description": "Five guards. One face. Zero job security.\n\n\rKronstadt takes security seriously. So seriously, in fact, that they hired the same man five times.\rFour are guarding the Kronstadt building. The fifth has apparently found himself a more relaxing assignment in the hotel garden.\r\n\nAgent 47, it&#39;s time for a little downsizing.\n\n\rMake sure none of them clocks out.",
