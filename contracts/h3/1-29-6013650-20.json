    "Metadata": {
        "Id": "f7e5142e-e83b-4278-93a5-35fc3c71d97d",
        "Type": "usercreated",
        "Title": "Hitman 6. Episode 8. Iron syndicate",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129601365020",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository cb61bb4f-ce40-4a6a-92c2-0d8989aef312).Image",
        "Description": "Good night 47. Tonight we have a Berlin drug gang called the Iron Syndicate. The biggest leaders of the Iron Syndicate are called Marius Schmitt, his brother Hagen Begger, and an even bigger entity Gustav Reuter. Our client is a scared gas station manager who lives near this nightclub. He has asked us to murder and destroy this union. In addition to drugs, they rob and abuse local people as they please. They have a big revenge, if you report them to the police, they will find you. Good luck.",
