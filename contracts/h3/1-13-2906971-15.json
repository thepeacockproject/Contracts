    "Metadata": {
        "Id": "9b96a3a6-f3bb-4e7d-ae26-f7d3e216ecaf",
        "Type": "usercreated",
        "Title": "The Rangan Tower Tragedy",
        "Location": "LOCATION_MUMBAI",
        "PublicId": "113290697115",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Mumbai/scene_mongoose.entity",
        "TileImage": "$($repository 22a19308-5b21-4e80-a915-467ebc43a1de).Image",
        "Description": "Good evening 47. Your targets are various guards within Dawood Rangan&apos;s organization.  You must also take out his painter, ensuring that a portrait of Rangan&apos;s likeness never sees the light of day. Additionally, the ICA will increase your next payment by 25% if you can figure out how to electrocute two targets to death without using tasers. We leave you to prepare. As always, good luck.",
