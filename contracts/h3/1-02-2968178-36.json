    "Metadata": {
        "Id": "0e85c91f-c8b7-42ed-aee2-0d129645f42a",
        "Type": "usercreated",
        "Title": "Part 2 - The Big Man Upstairs",
        "Location": "LOCATION_PARIS",
        "PublicId": "102296817836",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Paris/_scene_paris.entity",
        "TileImage": "$($repository 7809503d-5324-4e73-8915-db8b1e029151).Image",
        "Description": "Good evening, 47. The second contract of the bunch will have you in Paris, killing three minimum wage workers trying to make ends meet. I know that sounds bad, but it&apos;s for the greater good. Each one of them has, at one point or another, met with Netanyahu for his annual hunger games event in Israel. All three were the winners of previous events. If we are to strike Netanyahu, we must do it where it hurts, and kill three of his personal favorite previous winners. Good luck 47.",
        "GameVersion": "8.24.0.0",
