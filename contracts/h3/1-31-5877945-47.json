    "Metadata": {
        "Id": "2493d63f-03e1-49f6-9416-a56b93f42377",
        "Type": "usercreated",
        "Title": "Fade to Black",
        "Location": "LOCATION_ELEGANT_LLAMA",
        "PublicId": "131587794547",
        "ScenePath": "assembly:/_pro/scenes/missions/elegant/scene_llama.entity",
        "TileImage": "$($repository c480a7ee-33a3-4147-b2f1-fefb2ec8e1a3).Image",
        "Description": "Welcome to Mendoza 47\r\rCorvo and his subordinate Tommy are planning an assassination to murder Diana and her personal bodyguard, two guards patrolling the mansion basement and the winery security room are soon to be leaving in order to forge their plans of killing her, we can&apos;t let that happen! Looks like it was plan B of Don Yates all along. Eliminate all of your targets in accidents so no one suspects anything and take the villa boat to escape.\r\rGood Hunting",
