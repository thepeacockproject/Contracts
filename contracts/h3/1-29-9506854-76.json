    "Metadata": {
        "Id": "78390daf-63dd-4e5a-9a8b-410a3019542b",
        "Type": "usercreated",
        "Title": "Party Animals vs Party Crashers",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129950685476",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository e429d9b0-cced-4a71-a35c-b7d654a5d4e1).Image",
        "Description": "Welcome to Berlin\r\rTonight, 5 Targets known as The Crashers have arrived at the club. The club is home for many Furries to party and dance. But the Crashers are not just here to party, they are here to crash it. According to their records, they are known to ruthlessly end parties by making dramas, controversies, and false informations. Further more, they are linked with the Anti-Furry Community and have agents around patrolling. Eliminate the targets and make sure the party goes on.",
