    "Metadata": {
        "Id": "2e1efd2a-7f5a-4756-b27b-8540a39b920c",
        "Type": "usercreated",
        "Title": "Give Me Kalmer",
        "Location": "LOCATION_NORTHSEA",
        "PublicId": "121558334600",
        "ScenePath": "assembly:/_pro/scenes/missions/theark/scene_magpie.entity",
        "TileImage": "$($repository 4ac38f5e-98b8-489c-b5d4-a1f02824a26e).Image",
        "Description": "Agent,\n\nSg&#224;il hosts another secret gathering. Four targets are embedded across the event.\n\nAn Ark Member moves among the elite, protected by status. Their death must appear accidental. Electrocution will suffice.\n\nA chef works within routine and distraction. Use administered poison for a quiet kill.\n\nAn event staff member blends into the ceremony. Eliminate them directly with a pistol.\n\nA lone guard, the only male target, can be isolated. Dispatch him up close with a knife.\n\nEliminate each target while wearing their respective uniforms. Precision in disguise and execution is essential.\n\nYou may be tempted to rely on a Kalmer tranquilizer. You will not have that option. Adapt accordingly.\n\nGood luck, 47.",
        "GameVersion": "8.23.0.88",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_NORTHSEA"
        ],
        "CreatorUserId": "0e75b20e-57e8-4d55-809d-a119b9e28da2",
