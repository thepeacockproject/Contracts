    "Metadata": {
        "Id": "7e32297c-3e26-4d09-91e8-bf830156180f",
        "Type": "usercreated",
        "Title": "Letter of Resignation",
        "Location": "LOCATION_WET_RAT",
        "PublicId": "130752942598",
        "ScenePath": "assembly:/_pro/scenes/missions/wet/scene_rat_basic.entity",
        "TileImage": "$($repository a2429d84-2b78-42c4-a88d-82b8984ca92d).Image",
        "Description": "After countless hours of working in the kitchen, hundreds of meals served, and hoards of impatient, snobbish, and frankly rude restaraunt patrons, this was the final straw. This so-called &quot;Mr. Pritchard&quot;, lording himself over the service staff and treating chef 47 like some kind of inferior. Ungrateful! Ignorant block-headed fool of a customer! Time to send a very forceful letter of resignation. These patrons deserve what&apos;s coming to them.",
