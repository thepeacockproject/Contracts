    "Metadata": {
        "Id": "46c3192b-ec0a-432e-9cb9-ddd1bc0c7b48",
        "Type": "usercreated",
        "Title": "The Casting Call",
        "Location": "LOCATION_MUMBAI",
        "PublicId": "113400143113",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Mumbai/scene_mongoose.entity",
        "TileImage": "$($repository b0004597-ed47-41e2-a114-63566086668b).Image",
        "Description": "Good afternoon, 47.\r\rMumbai. Where dreams are manufactured, stars are disposable, and originality is apparently a luxury.\r\rOur client has identified five women. Five identities. One face. Two even wear identical costumes. Apparently, the wardrobe budget was cut along with the casting department. Anika has opted for a bold transformation - hardly an Oscar-worthy disguise... and unfortunately for her, the facial features remain unmistakable.\r\rWhether this is identity fraud or Bollywood&#39;s latest cost-cutting strategy is irrelevant.\r\rFive women. One final performance. No stand-ins. No retakes. No sequels.\r\rMake sure the final cut is permanent, 47.\r\rGood hunting.",
        "GameVersion": "8.25.0.95",
        "IsPublished": true,
