    "Metadata": {
        "Id": "cd0457e0-6549-400b-b5f3-a4cb506554a5",
        "Type": "usercreated",
        "Title": "マラケシュ/黄金の鳥カゴ　暗殺「7年間の不幸」取得用のミッション",
        "Location": "LOCATION_MARRAKECH",
        "PublicId": "106983885531",
        "ScenePath": "assembly:/_pro/scenes/missions/marrakesh/_scene_spider.entity",
        "TileImage": "$($repository 20fe3a6e-2274-4098-9247-91a74c8fe03f).Image",
        "Description": "暗殺「7年間の不幸」を取るためのミッションです。マーケット入り口から開始して、占い師にコインを与え追跡した先で衣装を占い師に着替えましょう。左から兵士1は感電死、女性はプロパンで爆死、兵士2は突き落として転落死、兵士3は便器で溺死、靴屋の店主は店の近くのドラム缶で焼死させましょう。兵士3のいるカフェに入るための会員証はターゲットの女性が所持しています。",
        "GameVersion": "8.18.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_MARRAKECH"
        ],
