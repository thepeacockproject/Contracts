    "Metadata": {
        "Id": "7b383bb7-a635-4c97-bd42-ea370533bf14",
        "Type": "usercreated",
        "Title": "Surf and Turf",
        "Location": "LOCATION_HOKKAIDO",
        "PublicId": "110201355752",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/_scene_snowcrane.entity",
        "TileImage": "$($repository 80643220-77ab-4427-8d79-4063fefd9870).Image",
        "Description": "Good afternoon 47.\r\rOur client is a 2 Michelin Star chef who is the former head chef of the GAMA Medical Facility in Hokkaido. He was recently fired so that GAMA could hire a 3 Michelin Star chef, whom had connections with Doctor Baumgartner.\r\rOur client requests that you reinstate his menu at GAMA, most importantly his famous Surf and Turf special. He has asked us to make sure that his dish is specifically received by GAMA patients. \r\rOne last thing, 47. Our client likes his steak...charred.",
        "GameVersion": "8.25.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_HOKKAIDO"
        ],
