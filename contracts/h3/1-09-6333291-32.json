    "Metadata": {
        "Id": "009fd830-727a-4741-bf28-f81a7463781f",
        "Type": "usercreated",
        "Title": "Hydra protocol",
        "Location": "LOCATION_COLORADO",
        "PublicId": "109633329132",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Colorado_2/_scene_bull.entity",
        "TileImage": "$($repository 95bfa85f-d47e-48a6-aaa2-f118a9eec0df).Image",
        "Description": "Good evening 47\r\rYou’re heading to Colorado. Five agents carry critical data in biometric chips — secure crypto-key servers. The chips trigger a full re-encryption purge on any sudden or violent death.\rWe need the keys intact. In exactly 11 minutes and 30 seconds the upload begins and the data will move to new carriers. Eliminate all five slowly and quietly so the chips register no critical event. The two upload operators must not complete the transfer. Avoid detection at all costs. Good luck",
        "GameVersion": "8.23.0.0",
