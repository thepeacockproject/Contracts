    "Metadata": {
        "Id": "c3c14c97-10eb-4ce3-8167-f625ee1851bd",
        "Type": "usercreated",
        "Title": "Dancing with the Stars",
        "Location": "LOCATION_MUMBAI",
        "PublicId": "113474559106",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Mumbai/scene_mongoose.entity",
        "TileImage": "$($repository c4043de4-9c70-4b50-a1ca-8bb39c68ad98).Image",
        "Description": "47, I&apos;m sure you&apos;ve heard of the show Dancing with the Stars. Well Tyra Banks has invited you to be on the show. And, because the Mumbai dancers are always the best, you&apos;re gonna learn a thing or two from them. And by the way 47, I&apos;m not talking about the dancing stars, I mean the ninja stars. Well, regardless, I wish you the best. Make sure you don&apos;t swing your shuriken too hard now, or we&apos;ll end up with a bat lodged in 47&apos;s ear. We surely don&apos;t want that. Good luck.\r\rSincerely, Diana Burnwood",
        "GameVersion": "8.7.0.0",
