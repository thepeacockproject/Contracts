    "Metadata": {
        "Id": "d8f69d0e-8176-4529-a5ef-dc85888c94ad",
        "Type": "usercreated",
        "Title": "The Bombastic Tour: The Malay Peninsula",
        "Location": "LOCATION_BANGKOK",
        "PublicId": "108320115306",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Bangkok/_scene_tiger.entity",
        "TileImage": "$($repository 001e429d-423d-4a98-b7f6-67773bbfded4).Image",
        "Description": "Agent, welcome to Bangkok. Today, we will again be helping strive towards the goal of investigating all of the peninsulas of the world. Today we will be investigating the Malay Peninsula, located in Malaysia, Myanmar and of course, Thailand. Even though Bangkok isn&#39;t along the peninsula, it is very close in proximity, meaning exploration can easily be done.\r\rLike always, you will be using your golf ball, baseball and frag grenade to help you make your discoveries. We may even see you pull out your big one to flatter all the hot Thai women ;)\r\rJust have fun, and be awesome at your job! Good luck. \r\n\r\n<HCCE>",
        "GameVersion": "8.13.0.58",
        "IsPublished": true,
