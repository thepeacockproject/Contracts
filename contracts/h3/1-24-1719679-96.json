    "Metadata": {
        "Id": "d8e445e4-c454-4ba8-a378-6fb79ec4b0a1",
        "Type": "usercreated",
        "Title": "Midas kills",
        "Location": "LOCATION_GREEDY_RACCOON",
        "PublicId": "124171967996",
        "ScenePath": "assembly:/_pro/scenes/missions/Greedy/mission_raccoon/scene_raccoon_basic.entity",
        "TileImage": "$($repository a60c2842-4ce5-4c72-a560-0d515d990eae).Image",
        "Description": "I hate this job so much. I hate my coworkers, Jim does coke and still gets promoted, Travers is always printing non-work related things on the photocopy machine, Matt and Ben go through the whole gallon of water before noon, does anyone but me do any actual work?! I might as well draw on microsoft paint instead of do any work! I&apos;d be equally as productive. I just can&apos;t wait for the day they&apos;re all gone and Ben&apos;s stocks he brags about are worthless. Stupid job. Stupid coworkers. Stupid life.",
        "GameVersion": "8.23.0.0",
