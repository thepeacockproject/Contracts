    "Metadata": {
        "Id": "36959b39-6964-4406-a209-73c887b0c01a",
        "Type": "usercreated",
        "Title": "Explosive Suburban Containment",
        "Location": "LOCATION_NORTHAMERICA",
        "PublicId": "122426466018",
        "ScenePath": "assembly:/_pro/scenes/missions/skunk/scene_skunk.entity",
        "TileImage": "$($repository 172ad969-2f84-47c5-a072-2587ebf92b55).Image",
        "Description": "They keep telling me I need to contain my explosive temper, so fine I will!\r\rWe (and by that I mean you) are going explode some annoyances and contain them.\r\rAll targets are annoying to various degrees and so they must be blown up and then be hidden. Apparently its not very silent, or professional, to just blow someone up and leave them there. So fine, here is me meeting you halfway there!\r\rWhere there is a will there is a way! To blow things up and stay silent! Sort of!",
        "GameVersion": "8.25.0.0",
