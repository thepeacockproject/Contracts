    "Metadata": {
        "Id": "7e8cc133-8961-41b3-8073-62edab21ee1e",
        "Type": "usercreated",
        "Title": "Death certificate",
        "Location": "LOCATION_ANCESTRAL_SMOOTHSNAKE",
        "PublicId": "133899670955",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_smoothsnake.entity",
        "TileImage": "$($repository b54e2809-7a46-48d3-aedc-73af497f3864).Image",
        "Description": "While not close, your targets, a collection of high class snobs at the top of society live in poverty for a tv show. Your job is to put their snobby behaviour to an end and reduce them to cold corpses. Keep an eye out as only certain methods wont leave a trace on their outfits and you need to blend into high class society as soon as possible. Lets stay silent my assasin, keep a level head and finish what we have been told to start.\r\rGood luck 47",
