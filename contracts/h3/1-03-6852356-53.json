        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_octopus.entity",
        "TileImage": "$($repository 3ed1c7e6-7707-48b4-a0f0-b933bc851fdb).Image",
        "Description": "McVeigh owes us money. He did&apos;t pay his rent, but I know for a fact that dirty rat just sold his tech start up for a wad of dough to his gal&apos;s old man. This disrespect won&apos;t be tolerated. \r\rI&apos;m gonna send in that fuckin&apos; maniac GIANCARLO SCARAPEDUCCI to take care of McVeigh and his gal real quiet like, and then send him over to take care of McVeigh&apos;s sister, make it look like that weirdo Claudio Spaghetti was tryna bang her in the closet or somethin&apos;...\r\rThat weirdo creeps me out, kill him too.",
        "GameVersion": "8.2.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_COASTALTOWN"
        ],
