    "Metadata": {
        "Id": "a10bfc85-a2c8-4ac6-8a25-f99c268e8b84",
        "Type": "usercreated",
        "Title": "BCR Vol. 108 - Haven a Bad Day?",
        "Location": "LOCATION_OPULENT_STINGRAY",
        "PublicId": "126100028151",
        "ScenePath": "assembly:/_pro/scenes/missions/Opulent/mission_stingray/scene_stingray_basic.entity",
        "TileImage": "$($repository b53fab67-524b-49d9-96af-31d62f67bbd1).Image",
        "Description": "Good Evening 47.\r\rAfter Dubai, our client came to Haven to recover. He ordered a burger. It arrived with pineapple. When he complained, five people assured him this was &quot;The Authentic Island Experience.&quot; He has now paid us a frankly embarrassing amount of money to ensure nobody experiences their hospitality again.\r\rEliminate all five. The chef is to be spared; he removed the pineapple and therefore qualifies as a protected wirness.\r\rWe are still arguing with Legal.\r\rGood Luck\r-Twiice",
        "GameVersion": "8.26.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_OPULENT"
        ],
