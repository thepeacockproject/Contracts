    "Metadata": {
        "Id": "fd046cb7-2c92-476f-b22f-0f291876957b",
        "Type": "usercreated",
        "Title": "Blade Runner",
        "Location": "LOCATION_WET_RAT",
        "PublicId": "130331927215",
        "ScenePath": "assembly:/_pro/scenes/missions/wet/scene_rat_basic.entity",
        "TileImage": "$($repository 785c685b-fcd8-44eb-8c94-2997a5888d26).Image",
        "Description": "We have notice that four replicants have entered the city. Standard &quot;retirment&quot; protocals stand. Thankfully none have infilitrated the facility... yet. 47, your job is to find these replicants and &quot;retire&quot; them. The public is not aware of them, keep it that way. As you know replicants have a 4 year life span. These are estimated between 3 and 4 years old. We believe some may so signs of sympathy, regret, and other feelings such as forgetting. We believe more may arrive in other areas soon.",
        "GameVersion": "8.13.0.0",
        "IsPublished": true,
