    "Metadata": {
        "Id": "e5606a92-70e5-4b7d-a9fc-4f1b05b91511",
        "Type": "usercreated",
        "Title": "One Man, Five Jobs",
        "Location": "LOCATION_COLOMBIA",
        "PublicId": "112484504413",
        "ScenePath": "assembly:/_pro/scenes/missions/colombia/scene_hippo.entity",
        "TileImage": "$($repository 4de33861-4aaa-42ec-816f-f23ff9ce6463).Image",
        "Description": "Good afternoon, 47.\n\n\rWe&#39;ve uncovered a rather unusual staffing arrangement within the Delgado cartel.\n\nThe same man has been identified at a construction site, a village bar, a jungle checkpoint, and the coca fields.\r\n\nEither the Delgado cartel employs five identical men, or one employee has taken on five jobs.\n\nImpressive work ethic. Questionable security, \rFor an organization that routinely makes people disappear, their inability to notice someone appearing five times is rather embarrassing.\r\n\nOur client would like this administrative oversight corrected. \n\nWhether you&#39;re dealing with five men or one exceptionally industrious employee is ultimately irrelevant.\n\n\rThe cartel is about to experience a significant reduction in productivity.\r\nGood hunting, 47.",
        "GameVersion": "8.25.0.95",
        "IsPublished": true,
