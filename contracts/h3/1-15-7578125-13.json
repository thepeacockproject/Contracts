    "Metadata": {
        "Id": "4a07e588-30da-45fb-adec-c9b7309090f3",
        "Type": "usercreated",
        "Title": "Your No.1 Fan",
        "Location": "LOCATION_COASTALTOWN_EBOLA",
        "PublicId": "115757812513",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/scene_ebola.entity",
        "TileImage": "$($repository d8b46cb7-3239-4d44-a9d6-cd44de8d2813).Image",
        "Description": "Dear Mr Black, I hope this letter finds you well. I am writing to inform you that I am your biggest fan EVER!!! And I am sooooo excited for the new book release. So much so, that at the upcoming book reading in Sapienza I will really bring your Cassandra Snow series alive by reenacting the three murders committed. Also, I know that the biggest critic of your work who called your imagination a leadless pencil is in the area! I will punish him for you Senpai! All the best. Your No.1 Fan! x",
        "GameVersion": "8.15.0.0",
        "IsPublished": true,
        "Entitlements": [
            "H1_LEGACY_EXPANSION"
        ],
        "CreatorUserId": "3306d69f-277b-42e1-9058-f527657a7414",
