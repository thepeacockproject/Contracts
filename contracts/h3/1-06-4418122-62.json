    "Metadata": {
        "Id": "f55b9715-d904-4a88-8e50-5c73d02b2d13",
        "Type": "usercreated",
        "Title": "The Mossad style",
        "Location": "LOCATION_MARRAKECH",
        "PublicId": "106441812262",
        "ScenePath": "assembly:/_pro/scenes/missions/marrakesh/_scene_spider.entity",
        "TileImage": "$($repository ca31c88f-d15e-407b-8407-231f1b068402).Image",
        "Description": "The Mossad is widely regarded as one of the most effective intelligence agencies in the world.\rOver the years, it has carried out dozens — and likely far more — of high-profile assassinations across the globe.\r\rTheir methods are precise, quiet, and leave a clear signature at the scene, even as the operatives themselves vanish without a trace.\rEvery kill is clean, calculated, and impossible to link back.\r\rWherever they operate, the impact is felt —\rbut the hand behind it is never seen.",
