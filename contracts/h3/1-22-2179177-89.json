    "Metadata": {
        "Id": "032dc6f4-3e6b-4399-ab6e-62519732d402",
        "Type": "usercreated",
        "Title": "The Silhouette in the Creek",
        "Location": "LOCATION_NORTHAMERICA",
        "PublicId": "122217917789",
        "ScenePath": "assembly:/_pro/scenes/missions/skunk/scene_skunk.entity",
        "TileImage": "$($repository 732e1679-daaf-4f0e-8eab-e3b87108488a).Image",
        "Description": "It&apos;s a great day to be alive in sunny suburban Whittleton Creek; birds are chirping in the trees, neighbours are having fun at Sarah&apos;s housewarming party, and everyone is content in their middle-class haven. Yet a dark shadow looms over the neighbourhood - laziness. The residents have worked hard to enjoy their beautiful homes, but some are reaping the benefits of the others. Become the silhouette and reap the souls of those slacking while you stay hidden in the shadows.",
        "GameVersion": "8.5.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_NORTHAMERICA"
        ],
