    "Metadata": {
        "Id": "6278be08-6762-48c4-98f6-d95d49762f19",
        "Type": "usercreated",
        "Title": "СНАЙПЕРСКАЯ ТРЕНИРОВКА",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111339569780",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository d262ec9c-97d0-4d92-97a6-f2f9e0378b86).Image",
        "Description": "доп условие: стрелять только в голову\r\rЗаказчик - представитель китайских спецслужб. Им удалось раскрыть ячейку агентов ЦРУ, которые должны устранить вероятного победителя гонки, связанного с компартией Китая. Они уже внедрены в состав персонала. Китайцы считают, что связь с Центром координирует еще пара агентов, которые находятся неподалеку и одеты в штатское.\r\rЗаказчик считает, что присутствие своих агентов на автодроме привлечет внимание охраны Нокса. Поэтому действовать придется в одиночку",
        "GameVersion": "8.24.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_MIAMI"
