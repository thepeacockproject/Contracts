    "Metadata": {
        "Id": "e278a7e5-cff9-4756-a4e3-f2633cbf86d2",
        "Type": "usercreated",
        "Title": "[The Eighth Protocol] Tetrodotoxin",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129996791947",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository 6e9ab2f7-1236-4dcf-b47d-5e36eaeeaa2a).Image",
        "Description": "He saw what you did in Chongqing. Watched through the facility&apos;s backup cameras. Kept the files. Your face. Every step.\rNow he hides in Berlin. Screens everywhere. Selling what he knows.\rHis partner is there too. Let him breathe. He&apos;s nobody.\rThe syringe in your pocket came from the same lab where you woke up. It was in the chamber. Next to you. Prepared for someone else. Now it has a purpose.\rA single mark, no bigger than a mosquito bite. He&apos;ll slump forward like he fell asleep on the job.",
        "GameVersion": "8.23.0.0",
