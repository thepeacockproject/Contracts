    "Metadata": {
        "Id": "a6183aa8-40c5-481a-8782-8a225765060f",
        "Type": "usercreated",
        "Title": "We Don’t Associate with the Help",
        "Location": "LOCATION_ICA_FACILITY",
        "PublicId": "101224476884",
        "ScenePath": "assembly:/_pro/scenes/missions/thefacility/_scene_polarbear_005.entity",
        "TileImage": "$($repository 35494743-6b3e-4ba2-8193-7a543a52bbf8).Image",
        "Description": "Good evening, 47.\n\nYour target is Tenho Valkama, a waiter at Haven Island. He’s part of a discreet operation among resort staff: drugging guests’ drinks and relieving them of valuables while they sleep.\n\nTheir latest victim? A guest who inadvertently brought along a USB security key—specifically, a FIPS 140-2 Level 3 encrypted dongle, the sole access point to a classified quantum computing system. The kind of device that doesn’t just store data—it controls it.\n\nThe client has contacted the resort, suggesting that if the key isn’t returned promptly, there will be consequences. Consider this assignment a demonstration of those consequences.\r\rCreated by ChRoNiCSmk305",
        "GameVersion": "8.19.0.71",
