    "Metadata": {
        "Id": "3cfd6c79-a310-4f30-b71d-102f2b561188",
        "Type": "usercreated",
        "Title": "Kill Order: Cleaning Duty",
        "Location": "LOCATION_BANGKOK",
        "PublicId": "108275943289",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Bangkok/_scene_tiger.entity",
        "TileImage": "$($repository 2f62e2dc-0a34-4f07-be3b-3ca5eda87bcb).Image",
        "Description": "Recently, a client of ours attended the Himmipan Hotel on a &quot;buisness&quot; trip and was booked into the Queen Suite. However upon arrival, the room was trashed and the staff refused to do anything about it. This is where you come in, 47. Deal with these subhuman minimum wage workers, and make sure they suffer. I will leave you to prepare.",
