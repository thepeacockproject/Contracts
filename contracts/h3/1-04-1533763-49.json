    "Metadata": {
        "Id": "e7b543fa-d6f8-43e1-8097-7835e10fce85",
        "Type": "usercreated",
        "Title": "Щит мафии",
        "Location": "LOCATION_COASTALTOWN_NIGHT",
        "PublicId": "104153376349",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_mamba.entity",
        "TileImage": "$($repository c96b6cc3-4fda-4fb0-a70b-9d3d654ada9f).Image",
        "Description": "С возвращением в Сапиенцу, 47-й. Сегодня наша цель - сокрушить силовой блок мафии. Пятеро элитных телохранителей: Квидо Манна, Пальмиро Радовано, Карло Оккупато, Ромоло Конти и Франческо Реттани - это не просто охрана, а костяк местной мафиозной группировки, виновной в десятках убийств. Заказчик требует полностью зачистить это подразделение. Они всегда начеку, отлично экипированы и не отходят от босса. Разделите их и уничтожьте. Удачи.",
        "GameVersion": "8.23.0.0",
