    "Metadata": {
        "Id": "43bc606d-8879-477f-9c6f-fde9a97e35e8",
        "Type": "usercreated",
        "Title": "Everyone&#39;s A Nail",
        "Location": "LOCATION_NORTHAMERICA",
        "PublicId": "122112967589",
        "ScenePath": "assembly:/_pro/scenes/missions/skunk/scene_skunk.entity",
        "TileImage": "$($repository 04099e27-3441-4488-b005-94e651dd4878).Image",
        "Description": "&quot;When you&#39;re  a hammer, everyone&#39;s a nail.&quot;\r\rThose were the last words Judy Edalita heard before being brutally executed by Spencer &quot;The Hammer&quot; Green. Judy&#39;s wife, Sharon Edalita has contacted us to fulfill a request. As opposed to killing Green, she wants green to suffer and rot in prison.You must frame Green by impersonating him and killing certain people who Green had grudges against.\rGood luck, 47.\r\rBy Georgikens\r&lt;HCCE&gt;",
        "GameVersion": "8.7.0.40",
        "IsPublished": true,
