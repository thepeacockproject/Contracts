    "Metadata": {
        "Id": "0cf97ccb-86e0-44f1-9b9e-afaee3924a1f",
        "Type": "usercreated",
        "Title": "Bogart 47 in: The Cypriot Eggs",
        "Location": "LOCATION_GREEDY_RACCOON",
        "PublicId": "124148935003",
        "ScenePath": "assembly:/_pro/scenes/missions/Greedy/mission_raccoon/scene_raccoon_basic.entity",
        "TileImage": "$($repository 799e5b66-b968-4ecf-b2f5-a99a892138fe).Image",
        "Description": "It was a stormy night when she walked through my office door. I was listening to my favorite saxophone record, so I didn&apos;t notice her arrival until she cleared her throat. &quot;Diana Burnwood,&quot; she introduced herself in a soft voice that most men would follow every instruction from, and I was no different. 4 eggs had been stolen. I had to get them back, and kill the thieves. As soon as I agreed, she murmured, &quot;Good luck, 47.&quot;\r\rTHIS CONTRACT IS MEANT TO BE DONE IN NOIR MODE, WITH ALL 4 EGGS COLLECTED",
        "GameVersion": "8.25.0.0",
        "IsPublished": true,
        "Entitlements": [
