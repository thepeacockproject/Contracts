    "Metadata": {
        "Id": "d19882e0-b2dd-4bef-a9db-7529b3af4e68",
        "Type": "usercreated",
        "Title": "THE BANK OF IDENTICAL TWINS\n\n",
        "Location": "LOCATION_GREEDY_RACCOON",
        "PublicId": "124104304313",
        "ScenePath": "assembly:/_pro/scenes/missions/Greedy/mission_raccoon/scene_raccoon_basic.entity",
        "TileImage": "$($repository 2f535f0e-c3f7-4274-bdec-50476b50e538).Image",
        "Description": "Good afternoon, 47.\r\r\rThe Milton-Fitzpatrick Bank has built its reputation on discretion, security, and keeping a straight face.\r\r\rApparently, just one face. One remarkably consistent appearance. Even their expressions suggest they&#39;ve all just been informed of the bank&#39;s interest rates.\r\r\rOur client considers this a serious case of identity confusion. The bank, naturally, considers it confidential.\r\r\rFive accounts to close, 47. Permanently.\r\r\rGood hunting.",
