    "Metadata": {
        "Id": "6d8cb883-6dec-4740-8eef-e78098d1d052",
        "Type": "usercreated",
        "Title": "Save Robert Knox&apos;s Agent",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111060967054",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository dd18fcaf-e145-4db7-91fc-54356e42d4fc).Image",
        "Description": "Good Evening, 47. Robert Knox, father of Sierra, hired a race marshall to plant a bomb on Moses Lee&apos;s car. Unfortunately, he was caught. Robert Knox has paid us to free him, this involves killing the guards who have knowledge about the situation, destroying cameras so they can&apos;t trace the agent and under no circumstances hurting the agent. Once you have finished, a Kronstadt helicopter awaits. Good luck, 47.",
