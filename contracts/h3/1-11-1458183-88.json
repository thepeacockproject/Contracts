    "Metadata": {
        "Id": "dc1ec1a4-d176-4ada-8925-1aef7f4df041",
        "Type": "usercreated",
        "Title": "Earthquake at Kronstad",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111145818388",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository ee454990-0c4b-49e5-9572-a67887325283).Image",
        "Description": "I have a great news Sir, Sierra Knox, Roberts pragmatic daughter, will cooperate with you on all levels. She told our associate, that today her father will be making presentation for military commander, Colonel Mendez. He will be showing him robotised weapons, that will be used to your assasination. I propose, you play the role of Ted Mendez, and at the best moment strike, to eliminate Knox, and his research team currently working on this technology. Good luck Sir",
        "GameVersion": "8.3.0.0",
