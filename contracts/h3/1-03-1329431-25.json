    "Metadata": {
        "Id": "86f4c1df-60b7-4572-a69c-84fe911d29e7",
        "Type": "usercreated",
        "Title": "Chitman Part 2: The Church of Chit",
        "Location": "LOCATION_COASTALTOWN",
        "PublicId": "103132943125",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_octopus.entity",
        "TileImage": "$($repository 45c2230a-3bda-4779-aedf-c713fc7ad87b).Image",
        "Description": "The Church of Chit is infamous for its involvment in drug and sex trafficking in the underground crime world, with its main base of operation being located in Sapienza, Italy. Our client has informed us about 2 major ring leaders beside Chit himself. They are Massimiliano Scanarotti, one of Chits head bodyguards, and Daniele Pozzi, a high-ranking, high-skilled undercover agent who has played a key role in many of Chit&apos;s schemes. \rGo get it, Agent 47. The Chit awaits",
        "GameVersion": "8.23.0.0",
