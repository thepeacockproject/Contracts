    "Metadata": {
        "Id": "d2219578-6cf9-44db-bfc7-c02945d1a8fe",
        "Type": "usercreated",
        "Title": "无奈之女",
        "Location": "LOCATION_COLORADO",
        "PublicId": "109624636632",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Colorado_2/_scene_bull.entity",
        "TileImage": "$($repository b01d3958-47d7-45cd-944b-d5107c8724b1).Image",
        "Description": "作为同样以“外人”身份加入的成员，玛耶对佩内洛普暗生情愫。她佩内洛普辗转反侧，可她从不会表达，最终把自己的爱转嫁到了在她眼里唯一算得上“优秀”的成员尖兵的身上，每晚都弄得他骨酥神麻。\r扮演尖兵，结束玛耶在营地中的孽缘。\r找到佩内洛普，让这位身不由己的女子从对影子的恐慌中解脱出来。",
        "GameVersion": "8.23.0.0",
