    "Metadata": {
        "Id": "996f98ca-277d-4a04-80d3-04101f61a4f4",
        "Type": "usercreated",
        "Title": "I know what you did last summer - Part 1",
        "Location": "LOCATION_ROCKY_DUGONG",
        "PublicId": "134582480836",
        "ScenePath": "assembly:/_pro/scenes/missions/Rocky/scene_dugong.entity",
        "TileImage": "$($repository 87a43919-2e2b-4958-9d02-3e93a5368e2d).Image",
        "Description": "Helen, Barry, Ray and Julie they commited a horrible crime by hit and run one year ago after an exzessive night on alkohol and drugs ... ICA intel found out: they got away with it and faked their deaths! Now after many surgeries to alter their looks and achieving new identities they think they are safe on this beautiful island they call now home! They think that the militia and pirate presence can keep them safe from the MAN with the HOOK but we know what they did that summer... make them pay!",
        "GameVersion": "8.9.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_ROCKY"
        ],
        "CreatorUserId": "217c7f22-fd80-42ba-a8f8-a4f5e502c149",
