    "Metadata": {
        "Id": "ab5ea84a-7517-4280-970e-79ef8da21bce",
        "Type": "usercreated",
        "Title": "Kitchen Nightmares #1",
        "Location": "LOCATION_WET_RAT",
        "PublicId": "130292474509",
        "ScenePath": "assembly:/_pro/scenes/missions/wet/scene_rat_basic.entity",
        "TileImage": "$($repository a2429d84-2b78-42c4-a88d-82b8984ca92d).Image",
        "Description": "My two best cooks think they can just steal my recipes and leave!? Oh no, we can not have this! It just so happens that  food critic, Angus Pritchard is attending their new restraunt! The same one that gave me a one star rating last visit. I want you to make sure he chokes, secondly I want that kitchen out of order. So rig the stove and make sure they are out of business for good. Then Jimmies Chicken Shack will be number one! Trains stop running soon so you will have to find another way out.",
        "GameVersion": "8.10.0.0",
