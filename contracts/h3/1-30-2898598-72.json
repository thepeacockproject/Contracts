    "Metadata": {
        "Id": "bc1bc575-8b13-4856-964a-bfed144f6aab",
        "Type": "usercreated",
        "Title": "Operation Skyfall: The Yuzhong Enigma",
        "Location": "LOCATION_WET_RAT",
        "PublicId": "130289859872",
        "ScenePath": "assembly:/_pro/scenes/missions/wet/scene_rat_basic.entity",
        "TileImage": "$($repository 663ac133-6e43-49ee-9a19-a277cab49bc5).Image",
        "Description": "La Carne took a serious blow thanks to you, but the trail in Santa Fortuna has gone cold. This remind me of a one of ICA&apos;s most legendary missions. Operation Skyfall: Agent Viceroy had singlehandedly eliminated a crime family with hanging objects. Though you are the best, she still made history in the agency. Hold on, conversation intel has revealed a cell, Xian Jing, in Chongqing&apos;s Yuzhong District. Their deaths must look accidental, perhaps you should take a page out of Agent Viceroy&apos;s book.",
