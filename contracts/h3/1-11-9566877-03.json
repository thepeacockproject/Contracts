    "Metadata": {
        "Id": "0373e1f5-fff3-4905-aea9-f28bcd9c2d02",
        "Type": "usercreated",
        "Title": "Deadly Rivals 22: Déjà Vu",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111956687703",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 0771273c-2ea6-4d2b-a636-409925f626c9).Image",
        "Description": "Good afternoon, 47.\r\rWe seem to have found ourselves in the middle of a diplomatic spat. Moses Lee is looking to sabotage Kronstadt&apos;s ties to the Pentagon by killing Colonel Mendez, who, in turn, wants to sabotage the Delgado Cartel by killing their benefactor Sheikh Al-Ghazali. Al-Ghazali has hired us to kill Lee to aid his upcoming hostile takeover of Kowoon.\r\rSheikh Al-Ghazali&apos;s presence is alarming, 47. We&apos;ve killed him twice now, and Klaus is no more. I&apos;ll look into it and get back to you.",
        "GameVersion": "8.21.0.0",
        "IsPublished": true,
