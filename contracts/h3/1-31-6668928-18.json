    "Metadata": {
        "Id": "ffe2317a-7ed2-4f36-ba82-7cfc3f23fabc",
        "Type": "usercreated",
        "Title": "THe AXE-cellent lawyer",
        "Location": "LOCATION_ELEGANT_LLAMA",
        "PublicId": "131666892818",
        "ScenePath": "assembly:/_pro/scenes/missions/elegant/scene_llama.entity",
        "TileImage": "$($repository 57907f04-329e-4faf-b753-7e95d5c2e085).Image",
        "Description": "Olivia here,  \r\rWe intercepted a call between Don Yates, his wife and a lawyer. Don called the lawyer to bring him Diana’s files. We don&apos;t exactly know why Don wants Diana&apos;s papers, but I do know one thing: we need to stop them!\r\rSo, my plan is that you kill the lawyer, take his clothes and go to the mansion. You can find Don and his wife there. AXE-cute them with the axe that is hanging on a wall in the mansion. You also need to kill  Franco with a sniper from the attic.\r\rGood luck, 47",
        "GameVersion": "8.7.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_ELEGANT"
        ],
