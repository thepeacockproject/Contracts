    "Metadata": {
        "Id": "03e6e26e-a29e-4c65-b539-e4afc3c25154",
        "Type": "usercreated",
        "Title": "Echoes of a Honeymoon",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129036422007",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository a326595c-bf01-431a-b8c4-abccadc8a2ad).Image",
        "Description": "Good evening, 47.\r\rYour targets are Nadav Vazana and Eden Rize, a newlywed couple exploiting marriage visas for profit.\r\rOperating from Berlin’s Club Hölle, they run a black-market identity ring hidden behind rave culture. Vazana monitors systems from the DJ booth; Rize lures clients in the VIP lounge. Eliminate both without collateral damage. Surveillance is light, but the crowd is dense. Discretion is advised. The ICA will not sanction a second attempt.\r\rGood luck, 47.",
        "GameVersion": "8.20.0.0",
