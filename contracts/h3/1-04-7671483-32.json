    "Metadata": {
        "Id": "02918dbd-059b-4d1b-ad8d-61dafc599ce7",
        "Type": "usercreated",
        "Title": "TEN HOURS TO ZERO: THE ITALIAN DOOMSDAY",
        "Location": "LOCATION_COASTALTOWN_NIGHT",
        "PublicId": "104767148332",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_mamba.entity",
        "TileImage": "$($repository 6490cc8d-9983-4476-a1a7-be53d1f7f784).Image",
        "Description": "Italy is facing an unprecedented threat. Five high-profile mafia criminals, led by Clodoveo Rametta, are preparing a coordinated bombing campaign across the country. With only 10 hours remaining, Italian intelligence has identified the five men responsible: Clodoveo Rametta, Cornelio Bellucci, Giacobbe Conti, Alessandro Rota and Fabian Desch. Rametta is the organization&apos;s leader and controls the operation. Agent 47 must stop the plot before time runs out. Five targets. Ten hours. One mission.",
