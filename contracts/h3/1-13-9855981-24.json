    "Metadata": {
        "Id": "6532bf94-bda6-4e91-ba3f-7845ea9d58b1",
        "Type": "usercreated",
        "Title": "The Conspirators",
        "Location": "LOCATION_MUMBAI",
        "PublicId": "113985598124",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Mumbai/scene_mongoose.entity",
        "TileImage": "$($repository 72aa012a-d74d-493f-8b84-397b95efd385).Image",
        "Description": "Good afternoon, 47. Wazir Kale, the former right-hand man of Lucas Grey, has uncovered a plot brewing in Mumbai&apos;s slums, with the intent of killing him. He has named five co-conspirators - Karan Dhar, a sniper known as &quot;The Kashmirian&quot;; Neha, Kale&apos;s ex-wife; Bharath Chilamkurthy, the local tailor; Bhavin Sagar, an in-demand barber; and Kafe Hussain, the holy man. You must eliminate all five, before they succeed in their plan. Good luck, 47.",
        "GameVersion": "8.23.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_MUMBAI"
        ],
