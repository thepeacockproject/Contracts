    "Metadata": {
        "Id": "30e00e99-8eae-4f75-ad61-4d6bd3628797",
        "Type": "usercreated",
        "Title": "Tide Hunt",
        "Location": "LOCATION_COASTALTOWN",
        "PublicId": "103234302702",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_octopus.entity",
        "TileImage": "$($repository 09e567eb-db00-473c-bac2-3e9f143dd755).Image",
        "Description": "Good morning, 47.\rYour target is a coastal fishmonger hiding behind fishing and angling. He gathers fishers to build fleets and smuggle drugs cross-border. He becomes a big transnational criminal group. Two undercover agents only watch acrobat shows and offer no help. Eliminate the boss and destroy his smuggling fleet by yourself.Happy Hunting!\r\r早上好，47。\r目标是渔港的鱼贩，平日里靠着捕鱼、海边垂钓伪装身份。他收拢码头渔民和垂钓爱好者组建私人船队，借近海作业的掩护，利用海域监管漏洞跨境走私DP与违禁货品，逐步壮大为跨国海上犯罪团伙。有两名特工提前卧底，却被安排去观看杂技，没法配合行动，你要孤身除掉头目、捣毁船队、斩断整条走私链。狩猎愉快！",
        "GameVersion": "8.23.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_COASTALTOWN"
        ],
        "CreatorUserId": "e697283e-c7a2-4fb6-a360-de9173020750",
