    "Metadata": {
        "Id": "61d5f47e-ff1a-4315-9a46-8302f5b1fda9",
        "Type": "usercreated",
        "Title": "I&apos;ve Had DartMoor Than Enough Of You",
        "Location": "LOCATION_ANCESTRAL_BULLDOG",
        "PublicId": "128288109125",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_bulldog.entity",
        "TileImage": "$($repository 5cfc8323-1053-4138-b2a4-2448b5003d1e).Image",
        "Description": "Here&apos;s the thing. These guys dated my sister. Lucian Parker and Ben Moore were both really bad kissers. Leonard had a wife. Isaac didn&apos;t know what a &apos;shower&apos; was and the lawyer made her sign an NDA so she couldn&apos;t tell anyone that he is actually a cyborg. The NDA is ruining our gossip at girls&apos; night, so we need your help. Eliminate them, and maybe we&apos;ll share our mojitos.",
        "GameVersion": "8.14.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_ANCESTRAL"
        ],
