    "Metadata": {
        "Id": "dff95e0c-6b05-4c6a-9cf1-a2695941843d",
        "Type": "usercreated",
        "Title": "Guns Of Providence",
        "Location": "LOCATION_MUMBAI",
        "PublicId": "113247969055",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Mumbai/scene_mongoose.entity",
        "TileImage": "$($repository 4965d0c2-23db-4170-829f-6b6bc4980d23).Image",
        "Description": "War has changed. It&apos;s an endless series of proxy battles fought by mercenaries and machines. Everything is monitored and kept under controll. The age of deterrence has become the age of control. And he who controls the battlefield controls history. Providence has become a gigantic entity, taking over everything in its path. All data and information are managed by an AI; if someone were to gain control of that AI, they would control the entire world. That&apos;s why we have to stop 74 and his PMC.",
