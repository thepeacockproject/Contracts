    "Metadata": {
        "Id": "6c7a5fff-a801-4daa-a803-8522d200c919",
        "Type": "usercreated",
        "Title": "背叛者",
        "Location": "LOCATION_HOKKAIDO_FLU",
        "PublicId": "118826954701",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/_scene_flu.entity",
        "TileImage": "$($repository f592a32a-32d4-48dd-a5cf-ee966a42c0b1).Image",
        "Description": "早上好，47，欢迎来到北海道。你这次的目标是已经背叛了以太公司的五名研究员。以太公司的高层近日发现关于欧文凯奇所感染的未知病毒的多处研究资料失窃，后经过调查发现公司内有内鬼向以太公司的竞争对手提供研究资料。目前以太公司已经抓住了一名内鬼，经过询问得知在研究现场有五名内鬼正准备破坏研究。所以以太公司为了报复让我们消灭这五名背叛者。但研究现场戒备森严，所以你没办法正常进入设施。同时不能让这五名背叛者察觉，所以你要小心行事。祝你好运，47，我就不打扰你准备了。",
        "GameVersion": "8.14.0.0",
        "IsPublished": true,
        "Entitlements": [
            "H1_LEGACY_EXPANSION"
        ],
