    "Metadata": {
        "Id": "b8fb50a0-f03b-46ce-b3d5-406a8d6fa595",
        "Type": "usercreated",
        "Title": "BCR Vol. 87 - 047 Last Shadow",
        "Location": "LOCATION_BANGKOK",
        "PublicId": "108647693333",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Bangkok/_scene_tiger.entity",
        "TileImage": "$($repository 2ea8ef96-7380-447d-a6bf-19a3fa01bc19).Image",
        "Description": "We have an urgent matter on our hands.\rSightings of PMCs around the Himmapan indicate that Umbra Concilium might convene in Bangkok. Technocrats from all over the world will attend the secret gathering. Illegal Military Intel is sure to change hands if we don&apos;t intervene. Our client MI6 gave us a hitlist and demands the job be carried out adhering to their code. Unless you have the license to kill, hits will have to look like accidents. Smart use of gadgets is vital.\r\rGood Luck 047\r\rBy Celllie",
