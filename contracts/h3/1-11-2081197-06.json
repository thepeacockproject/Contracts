    "Metadata": {
        "Id": "41a2e1d9-1969-4580-adaf-5932d6443835",
        "Type": "usercreated",
        "Title": "Nachm Abi in Miami",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111208119706",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository f3e796af-bc6f-41db-8694-1424235250e7).Image",
        "Description": "Ein Blick in die Jugendzeit von 47:\rBei seinem FSJ als Rennwart in Miami fühlt sich 47 sehr wohl. Einige Dinge stören ihn aber auch...\rZum Beispiel ist der Uferbereich voll mit ein paar  Nuttensöhnen, derer sich 47 gerne entledigen würde. Zudem kotzt es ihn hart an, dass sich 2 seiner temporären Kollegen über seine Glatze lustig machen. Er hätte gerne einfach RUHE. 47 will ein wenig Abwechslung in die Kills bringen, darf sich aber auch nicht zu lange Zeit lassen, da bald die nächste Schicht ist",
        "GameVersion": "8.13.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_MIAMI"
        ],
