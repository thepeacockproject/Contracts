    "Metadata": {
        "Id": "3ba44616-3103-412c-8eeb-caa1f00d3e20",
        "Type": "usercreated",
        "Title": "007: &quot;counter espionage&quot; in Paris",
        "Location": "LOCATION_PARIS",
        "PublicId": "102398451281",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Paris/_scene_paris.entity",
        "TileImage": "$($repository a245262c-3e66-4477-b334-0f693ed5acb7).Image",
        "Description": "Goodmorning, 007 \r\r  The counter intelligence department informed us that our Ambassador has been targeted during his diplomatic visit at the Paris fashionshow. \r \r  The initial plan is to poison him during dinner. Two people have been inserted in the palace and IAGO staff to poison the ambassador&apos;s drink should that plan fail. The last resort is a bomb technician named Marcel Dimarco who is to await further instructions disguised as a crew member in the catering delivery area.\r\r Good luck 007",
        "GameVersion": "8.24.0.0",
