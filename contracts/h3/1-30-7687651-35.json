    "Metadata": {
        "Id": "e7c001b8-3e0b-4ae1-a2d6-81aaf536b149",
        "Type": "usercreated",
        "Title": "Японская месть",
        "Location": "LOCATION_WET_RAT",
        "PublicId": "130768765135",
        "ScenePath": "assembly:/_pro/scenes/missions/wet/scene_rat_basic.entity",
        "TileImage": "$($repository a2429d84-2b78-42c4-a88d-82b8984ca92d).Image",
        "Description": "Добрий вечер 47-й, сегодня нам поступил контракт с японии от члена якудза, они нам заказали 5 человек которые по случайному стечению событий оказались в одном китайском ресторанчике , они по их словам они слили ихних людей полиции и из-за этого много людей из рядов якудзы погибли в перестрелке с полицией.\rУбей Агнуса, Джинхай и Чонглин в стиле якудзи а именно в юкате и с помощью танто, остальних двух как хотите.\rИ помните не попадитесь, удачи 47-й якудза, надеется на вашу профисиональность.",
        "GameVersion": "8.18.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_WET"
        ],
