    "Metadata": {
        "Id": "ae2c0b46-dd28-4e83-a8a2-4e036ee6fe0f",
        "Type": "usercreated",
        "Title": "ICA Data Leakers",
        "Location": "LOCATION_WET_RAT",
        "PublicId": "130736473603",
        "ScenePath": "assembly:/_pro/scenes/missions/wet/scene_rat_basic.entity",
        "TileImage": "$($repository 92532bb0-0f92-4bbe-847f-4c248729cb14).Image",
        "Description": "Good evening 47. We&apos;re sending you to Chongqing where some of our most classified databases are kept.\r\rAs you know, working for ICA requires a strict adhearance to the non-disclosure agreement. However some employees seem to have forgotten the fine-print of the contracts they signed, and have accidentally leaked some highly classified information. \r\rThis is a mistake the ICA cannot tolerate. Assassinate the leakers with fiber wire, we don&apos;t want their last moments to pleasant.\r\rGood Hunting 47.",
        "GameVersion": "8.7.0.0",
