    "Metadata": {
        "Id": "1a894358-2e0d-4430-aec8-c8f035373cbe",
        "Type": "usercreated",
        "Title": "High Octane Killing",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111446744821",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository d96dd365-1035-4c34-a605-32899a8fd67a).Image",
        "Description": "Good afternoon, 47. Your destination is once again to the Global Innovation Race in Miami, where 5 race teams have lined up for the illustrious trophy.\r\rUnfortunately, all teams are cheating, and using a Kronstadt branded high octane boost, which allowed them to breeze through the qualifying rounds. Our client, a rival race team, wants revenge, and to tank the reputation of the octane booster to avoid future cheating. Having it explode in the face of the 5 head mechanics of each team might do it",
        "GameVersion": "8.11.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_MIAMI"
        ],
