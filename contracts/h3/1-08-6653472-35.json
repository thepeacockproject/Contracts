    "Metadata": {
        "Id": "8a2e058c-9a27-4266-81d5-38b77c0b74c7",
        "Type": "usercreated",
        "Title": "No Smoking At the Hotel",
        "Location": "LOCATION_BANGKOK",
        "PublicId": "108665347235",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Bangkok/_scene_tiger.entity",
        "TileImage": "$($repository ecd9fc59-75d1-4857-bb76-a545142fe05d).Image",
        "Description": "Mrs. Mookjai wants to have a strict no somoking hotel, even outside of the hotel itself. However some staff has protested against this and &quot;what a surprise!&quot; The ones who protested are all smokers. She wants us to eliminate these four workers so so can set a smoking ban in motion for the hotel. But to prove smoking kills, it has to be done in a way where smoking literally kills them. I&apos;m sure you can figure this one out 47. Good luck!",
        "GameVersion": "8.23.0.0",
