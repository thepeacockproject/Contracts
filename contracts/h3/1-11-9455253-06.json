    "Metadata": {
        "Id": "f98d19bf-ebc9-44e0-b0d8-922deba7c9e0",
        "Type": "usercreated",
        "Title": "Master Chef 47 - Part 6",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111945525306",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 55c9c357-9b04-4506-a13b-98fae0958d61).Image",
        "Description": "It has been quite some time now since 47 has shown himself to the public, after a series of incidents in past locations around the world. But now he has returned, to show the world his craftsmanship. He decided to start anew as a humble food vendor in Miami, but as it turns out the ghost of his past crimes follows in his wake as the competition in the area is strong. Old urges are not forgotten that quickly.",
