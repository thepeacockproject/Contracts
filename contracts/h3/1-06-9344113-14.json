    "Metadata": {
        "Id": "3d6b4c1c-43fe-4161-91b0-fe13b2f690a1",
        "Type": "usercreated",
        "Title": "Security Check / 安全检查",
        "Location": "LOCATION_MARRAKECH",
        "PublicId": "106934411314",
        "ScenePath": "assembly:/_pro/scenes/missions/marrakesh/_scene_spider.entity",
        "TileImage": "$($repository 727d4aa7-b896-47fe-b0b6-c59926a68ad6).Image",
        "Description": "It turns out Kong&apos;s buyer was the security heads of Sweden Embassy. They were bribed by FSB to smuggle those weapons into the embassy and blame it on NATO when the weapons were found by Moroccan government. SÄPO has hired us to get rid of the traitors and the weapons, which are hiding in a black car in the parking lot. Lycka till 47.\r\r原来贡的买家是瑞典大使馆的安保主管们。被FSB贿赂的他们将武器走私进大使馆，并且打算在摩洛哥政府发现后将责任栽赃到北约头上。瑞典安全局雇佣我们除掉叛徒并将那些武器带出大使馆，它们被藏在了停车场的一辆黑色汽车里。Lycka till（瑞典语“祝你好运”）47。",
        "GameVersion": "8.10.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_MARRAKECH"
