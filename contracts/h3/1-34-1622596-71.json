    "Metadata": {
        "Id": "3ea3acf6-cf8a-4c82-9c30-d9fda8186bc2",
        "Type": "usercreated",
        "Title": "Operation Omicron 2",
        "Location": "LOCATION_ROCKY_DUGONG",
        "PublicId": "134162259671",
        "ScenePath": "assembly:/_pro/scenes/missions/Rocky/scene_dugong.entity",
        "TileImage": "$($repository 679eaa07-52f4-4419-ae39-a1582ac0f0ba).Image",
        "Description": "Good evening, 47.\rWe have acquired information on the next move of European weapons smuggling syndicate &quot;Omicron&quot;.\rAfter our mission in Paris, they have ordered a major delivery to a militia base on Ambrose Island. To make them vulnerable, we need to eliminate their undercover lookouts across the south coast. We ask that you also steal a small boat they plan to use for monitoring the nearby waters.\rAlerting locals may compromise you, so try to use their positions to your advantage.\rGood luck.",
        "GameVersion": "8.26.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_ROCKY"
        ],
