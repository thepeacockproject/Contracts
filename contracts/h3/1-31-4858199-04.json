    "Metadata": {
        "Id": "14e2705f-f9df-448f-b1ce-8c260b76e6aa",
        "Type": "usercreated",
        "Title": "Santa&apos;s Workshop Strike",
        "Location": "LOCATION_ELEGANT_LLAMA",
        "PublicId": "131485819904",
        "ScenePath": "assembly:/_pro/scenes/missions/elegant/scene_llama.entity",
        "TileImage": "$($repository 12a79b1b-fea9-4a0b-811b-9ca741f15d70).Image",
        "Description": "47,\r\rOur client is a wealthy industrialist who runs a series of workshops. Sadly his workshop in Mendoza currently has a walkout of staff, who are slacking off instead of making toys during the busy Christmas period.\r\rDue to the walkout you&apos;ll need to find a workshop bench and make a toy yourself, there should be one in the mercenary area, then use that toy to deal with the slackers and send a message to the rest of the staff.\r\rMerry Hunting",
        "GameVersion": "8.7.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_ELEGANT"
        ],
        "CreatorUserId": "41d3e6b4-5d55-47d5-84d2-07fc1a8be6ff",
