    "Metadata": {
        "Id": "abc2a98d-d880-409b-b4ad-d8540c347f81",
        "Type": "usercreated",
        "Title": "The Fifth Column",
        "Location": "LOCATION_COLORADO",
        "PublicId": "109155932013",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Colorado_2/_scene_bull.entity",
        "TileImage": "$($repository eab71738-4df4-4b32-a49a-3704bef210ab).Image",
        "Description": "A storm gathers over the Colorado plains. Behind rusted fences and watchful gun barrels, a militia prepares for enemies beyond its borders.\r\n\nBut the threat is already inside.\r\n\nFive technicians. Five identical faces. Scattered across the compound, hidden in plain sight.\n\n\rIn a place where everyone suspects a traitor, nobody seems to question the man they keep seeing twice.\n\n\rOr five times.\n\n\rSomeone has infiltrated the ranks, 47. Your task is to dismantle the Fifth Column before anyone notices the pattern.\n\n\rFive faces. One identity. No survivors.\r\n\nGood hunting.",
        "GameVersion": "8.25.0.95",
