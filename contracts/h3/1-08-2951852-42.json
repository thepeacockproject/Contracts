    "Metadata": {
        "Id": "234737b3-2596-4b7d-94e6-54af7bba640e",
        "Type": "usercreated",
        "Title": "BCR Vol. 102 - Axellent Subterfuge",
        "Location": "LOCATION_BANGKOK",
        "PublicId": "108295185242",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Bangkok/_scene_tiger.entity",
        "TileImage": "$($repository 7847b56a-640d-42ff-ba96-9043b76cff74).Image",
        "Description": "Hello Agents,\r\rour main target for today is Ben Bertram. He is a prolific serial stalker known for his reckless behaviour, including trespassing and prolonged harassment of his victims. One of his past victims could not bear the trauma of his abuse ,fled the country, changed her identity and broke off all contact. One of her left behind friends hired us to enact revenge where the law would not act. Take out the target and some bystanders to make it look like a stalking gone wrong.\r\rBy Celllie",
