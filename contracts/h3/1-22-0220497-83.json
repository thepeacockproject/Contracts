    "Metadata": {
        "Id": "98986825-8972-407e-a1fa-663af2941a73",
        "Type": "usercreated",
        "Title": "Old Fashioned Axe Juggler (redux)",
        "Location": "LOCATION_NORTHAMERICA",
        "PublicId": "122022049783",
        "ScenePath": "assembly:/_pro/scenes/missions/skunk/scene_skunk.entity",
        "TileImage": "$($repository 5f307b57-55e8-4f56-97f3-397df9e3dd96).Image",
        "Description": "Good afternoon, 47.\r\rOur contract is Joshua Griswold, aspiring musician. He claims four of the neighbourhood&#39;s older residents have conspired to get him evicted. This would spell homelessness and the end of his musical career. He supplied us with intel on Jordan Cross in the past and he asked for our help with this matter in payment. He wants them gone. But quietly, with no bodies found. His instructions were - and I quote: &quot;They want old fashioned, let&#39;s show &#39;em old fashioned. With axes!&quot;",
        "GameVersion": "8.8.0.42",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_NORTHAMERICA"
        ],
