    "Metadata": {
        "Id": "010c3020-ae64-4b82-8b24-ea56eda92dd1",
        "Type": "usercreated",
        "Title": "Don&apos;t Let Me Be Misunderstood...",
        "Location": "LOCATION_HOKKAIDO",
        "PublicId": "110268610857",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/_scene_snowcrane.entity",
        "TileImage": "$($repository f19cb43e-7f33-4d27-aa42-ecd7918eb2fe).Image",
        "Description": "This one is very interesting, 47. \r\rOur client, a Shinto priest, is infuriated by the handling of a fellow kannushi&apos;s body by Katashi Ito and his staff. He claims that his friend&apos;s body was mangled in a dishonorable way, and in spite of his status as a clergyman, wishes the same to be done to the mortuary staff. \r\rHis one wish in the course of this was to &quot;use weapons that would restore honor&quot; and &quot;wear a fearsome garment&quot;, keep this in mind as I leave you to prepare.",
        "GameVersion": "8.6.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_HOKKAIDO"
        ],
        "CreatorUserId": "12ae23b6-47d9-4928-843d-540f5c468428",
