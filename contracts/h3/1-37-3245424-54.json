    "Metadata": {
        "Id": "bc26f28f-b775-42a8-8eb6-43ccfcb83774",
        "Type": "usercreated",
        "Title": "And I Saw, and Behold, a White Horse...",
        "Location": "LOCATION_HOKKAIDO_MAMUSHI",
        "PublicId": "137324542454",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/scene_mamushi.entity",
        "TileImage": "$($repository 743eae7d-2d6c-4911-8334-5ddbbe63f1be).Image",
        "Description": "Hello, 47!\r\rIt is me, David Lynch, and I have concoted a new movie idea over a pot of black coffee.\r\rI would like you to perform some practical effects by eliminating the designated targets, all of whom are patients committed to the facility. Each one represents another facet of death, including violence, jelousy, indiscrimination, invasiness, and reflection.\r\rPlease wear the glamourous white suit provided, and make the death personal.\r\rAnd I saw, and Behold, a White horse...",
        "GameVersion": "8.25.0.0",
        "IsPublished": true,
        "Entitlements": [
