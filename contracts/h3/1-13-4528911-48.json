    "Metadata": {
        "Id": "74071843-97d4-4c0e-b0ae-31f28305319b",
        "Type": "usercreated",
        "Title": "Corsican Pt4: The Kashmirian",
        "Location": "LOCATION_MUMBAI",
        "PublicId": "113452891148",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Mumbai/scene_mongoose.entity",
        "TileImage": "$($repository 80051c02-e026-40fe-970a-7b7aaa62302c).Image",
        "Description": "The Corsican hired the Drinkmaker to poison someone, a job that would have gone to Helen West had we not eliminated her. Losing funds from our siege on him, the Corsican has hired Nathaniel Blake to steal a painting from renowned artist and former serial killer Babu Raav. He has also hired the Kashmirian to assassinate Mr. Raav afterwards, in order to increase the value of his final painting. He is now using funds from a personal account. Eliminate them, and we will know who the Corsican is.",
        "GameVersion": "8.9.0.0",
        "IsPublished": true,
