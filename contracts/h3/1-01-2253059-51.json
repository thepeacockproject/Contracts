    "Metadata": {
        "Id": "a28bbd70-999e-413b-959b-6500331c167b",
        "Type": "usercreated",
        "Title": "47 and the raiders of the ark - Part 4",
        "Location": "LOCATION_ICA_FACILITY",
        "PublicId": "101225305951",
        "ScenePath": "assembly:/_pro/scenes/missions/thefacility/_scene_polarbear_005.entity",
        "TileImage": "$($repository b942c2a5-99e5-46a7-a2b1-017ae56864cf).Image",
        "Description": "47, 47 are you there?! Thank god, I thought you were gone. Based on the GPS tracker in your clothes, the Russians took you to their base of operations after they ambushed you. The inside man at MIT who blew your cover, Jasper Knight is also there, along with FSB chief Cilas Netzke. Our intel says the Russians have the ark, but it&apos;s no longer there. The US services are trying to locate it now. Someone helped them. Take out Knight and the FSB operatives who led the mission and escape.",
