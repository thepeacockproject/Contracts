    "Metadata": {
        "Id": "5a70d1f4-d48c-4aca-9885-2265d1e4b010",
        "Type": "usercreated",
        "Title": "Gravity of Colorado",
        "Location": "LOCATION_COLORADO",
        "PublicId": "109203916700",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Colorado_2/_scene_bull.entity",
        "TileImage": "$($repository 600907b3-8143-401d-900c-42fe9c70064b).Image",
        "Description": "Good evening, 47.\n\nOur client has requested the elimination of five militia members currently operating in Colorado.\n\nThree targets are to meet their end in tragic falls, while the remaining two must perish in accidental explosions.\n\nThere is, however, one complication. The area offers remarkably few opportunities for a fatal fall.\n\nWhether by ingenuity, engineering, or a healthy respect for gravity, the outcome must appear accidental.\n\nI trust you&#39;ll find a way.\n\nGood luck, 47.",
