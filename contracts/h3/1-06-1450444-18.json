    "Metadata": {
        "Id": "d955a031-22dd-4661-9507-0e017dbf25b2",
        "Type": "usercreated",
        "Title": "Seven Years Bad Luck (Sieker required)",
        "Location": "LOCATION_MARRAKECH",
        "PublicId": "106145044418",
        "ScenePath": "assembly:/_pro/scenes/missions/marrakesh/_scene_spider.entity",
