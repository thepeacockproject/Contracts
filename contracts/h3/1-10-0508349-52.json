    "Metadata": {
        "Id": "fe6bd247-eec9-4b2b-a7d0-a4a59a1d1860",
        "Type": "usercreated",
        "Title": "Surf and Turf Special",
        "Location": "LOCATION_HOKKAIDO",
        "PublicId": "110050834952",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/_scene_snowcrane.entity",
        "TileImage": "$($repository 80643220-77ab-4427-8d79-4063fefd9870).Image",
        "Description": "Good afternoon 47.\r\rOur client is a 2 Michelin Star chef who is the former head chef of the GAMA Medical Facility in Hokkaido. After his firing from the facility, he was replaced by a 3 Michelin Star chef who had a connection with Doctor Baumgartner. \r\rOur client wants you to reinstate his menu at the GAMA Facility, most importantly his signature dish: the Surf and Turf special, to get payback for being let go.\r\rOne final thing, 47. Our client likes his steak...charred. Good luck.",
        "GameVersion": "8.25.0.0",
        "IsPublished": true,
