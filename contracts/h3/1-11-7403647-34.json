    "Metadata": {
        "Id": "3d2cab88-6df4-4350-8dba-c522ff8f3ad2",
        "Type": "usercreated",
        "Title": "Grant Adventures #3: West Virginia Men",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111740364734",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 9b0d0651-4f81-40e5-bf2a-5aec6fd763a5).Image",
        "Description": "Agent Grant 47, your targets are linked by a trail of blood from Miami to West Virginia.\r\rRobert Knox has pivoted from racing to war, using his &quot;innovation&quot; to develop lethal robots. \r\rFacilitating this is Johnattan Kindane, who uses rural Appalachian fronts to hide the tech&apos;s grisly field tests. \r\rTogether, they’ve turned the track into a testing ground for murder. \r\rInfiltrate, eliminate the five key players, and ensure this machine never crosses the finish line.",
