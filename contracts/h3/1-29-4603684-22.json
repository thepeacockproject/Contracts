    "Metadata": {
        "Id": "54365bc3-ae60-4f3f-9f26-b3fc65f6e90f",
        "Type": "usercreated",
        "Title": "German Pretzel Delivery",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129460368422",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository bf185f2f-17c7-414c-b237-6b2cc8a13b69).Image",
        "Description": "Hi Tobias,\r\rIt&apos;s been 46 times now that this bunch ordered pretzels from our bakery (delivery through the IC-eAts app) and no tip was ever given.  Two star reviews, fake complains to extort partial refunds... and they keep ordering.  If this continues, we will be soon out of business. Please make this delivery as professional as possible, so that our customers are finally pleased. \r\rBest regards,\rKruger Bakes Management",
        "GameVersion": "8.24.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_EDGY"
        ],
