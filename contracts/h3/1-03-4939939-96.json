    "Metadata": {
        "Id": "c8d6107c-f624-4593-8655-3dc1f52e6323",
        "Type": "usercreated",
        "Title": "The Culling: Part 4",
        "Location": "LOCATION_COASTALTOWN",
        "PublicId": "103493993996",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_octopus.entity",
        "TileImage": "$($repository bb15423f-bc60-4c49-ae0b-ee0a8843cbcc).Image",
        "Description": "47, we have more of society&apos;s filth to clean up today. First, the street performer, for obvious reasons. Old, loud, stuck up chefs who think they know it all and put their sous chefs through hell can be rid of as well. People who wear their sweater like a scarf in weather that&apos;s far too hot to ever need it, absurd. That one lady who holds her phone like...that, haven&apos;t noticed yet 47? take a look for yourself. And finally, cyclists, always their fault. You can deal with them 47, can&apos;t you?",
        "GameVersion": "8.26.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_COASTALTOWN"
        ],
