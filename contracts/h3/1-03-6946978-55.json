    "Metadata": {
        "Id": "e908a78a-86bc-4598-9409-af39f8a043ea",
        "Type": "usercreated",
        "Title": "Down the rabbit hole",
        "Location": "LOCATION_COASTALTOWN",
        "PublicId": "103694697855",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/CoastalTown/_scene_octopus.entity",
        "TileImage": "$($repository 77154a7c-89d0-49df-82ae-6810e27ec9ca).Image",
        "Description": "Good afternoon, 47. The Don was pleased with your actions in Chongqing. Divine justice was served, he said. But that was far from the end. It looks like the hit by Yakuza was ordered by someone in our own yard. The traitors were identified and a contract was issued, 2 bullets to the head, so we would send a clear message. \rBut there is more. They were in business with 2 federal agents, You must silence those two as well, permanently. Make their deaths look like accidents.\rGood luck.",
        "GameVersion": "8.24.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_COASTALTOWN"
        ],
