    "Metadata": {
        "Id": "28a8b0a7-bba1-4ec4-829a-b2e4add04adb",
        "Type": "usercreated",
        "Title": "Tomato Sauce Is Back On The Menu Bois",
        "Location": "LOCATION_ANCESTRAL_SMOOTHSNAKE",
        "PublicId": "133383166011",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_smoothsnake.entity",
        "TileImage": "$($repository 70d692cf-ef05-44a6-8531-8ba2952d4b58).Image",
        "Description": "Hi, this is Jimmy from Event Management.\r\rThe Carlisle Family has instructed us to continue serving dishes with the tomato sauce as it appears that the incident involving emetic material making its way into the pot was a one-time-accident.\r\rMoreover, the plant used for our special ingredient has been stolen from the Greenhouse, so just make sure you get it done in time with the supplements as attached! Can&apos;t have out guests starving until the show begins.\r\rInk mixing instructions:\r3x Red\r1x Blue",
