    "Metadata": {
        "Id": "792c420e-b9ba-4458-be3f-f24a2b714290",
        "Type": "usercreated",
        "Title": "warcrime coverups",
        "Location": "LOCATION_ELEGANT_LLAMA",
        "PublicId": "131774332248",
        "ScenePath": "assembly:/_pro/scenes/missions/elegant/scene_llama.entity",
        "TileImage": "$($repository dee56c2d-e1cf-496f-be2d-78aa42477d85).Image",
        "Description": "Good afternoon, 47.\rFour of your targets today have all been involved in covering up warcrimes commited by another sanctioned target, a Mr Hernan De Stefano. the two reporters prevented the news from being public, whilst the two lawyers are accused of bribery and evidence destruction.  Our client has  requested you eliminate them all, with methods as brutal as they warcrimes they covered up.\rGood luck, agent.\rDiana.",
        "GameVersion": "8.4.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_ELEGANT"
        ],
        "CreatorUserId": "277196d0-a736-46ad-9af4-c89d954483f4",
        "ServerVersion": "8.4.0.25",
        "CreationTimestamp": "2021-06-06T15:26:58.9980839Z",
