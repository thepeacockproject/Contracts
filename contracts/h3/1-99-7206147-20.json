    "Metadata": {
        "Id": "4ab0aab6-fce0-4028-8cc1-172fd5aef648",
        "Type": "usercreated",
        "Title": "High Society, a Bodyguard And a Chef",
        "Location": "LOCATION_ICA_FACILITY_SHIP",
        "PublicId": "199720614720",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/TheFacility/_Scene_Mission_Polarbear_Module_002_B.entity",
        "TileImage": "$($repository 4b4ec8c3-3af3-4d64-92fe-0a746899251b).Image",
        "Description": "A contract has been issued, and you have been cleared to engage. Avoid collateral damage as far as possible.\r\rThe chef poisoned someone who was near and dear to the client.\r\rThe bodyguard has a history of killing the client&apos;s mother for looking at him funny.\r\rThe rich art enjoyers have ripped off the client&apos;s little brother.\r\rAnd the Tex Macadoo lookin&apos; ass sold worthless land to the client&apos;s grandpa.\r\rCoincidentally, the group of people are in the same party. Kick ass!!",
