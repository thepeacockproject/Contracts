    "Metadata": {
        "Id": "0a81f618-81ac-4309-bbe7-7ebd49ac2266",
        "Type": "usercreated",
        "Title": "Elegy of the Falling City",
        "Location": "LOCATION_GREEDY_RACCOON",
        "PublicId": "124857344900",
        "ScenePath": "assembly:/_pro/scenes/missions/Greedy/mission_raccoon/scene_raccoon_basic.entity",
        "TileImage": "$($repository 25d7b1c0-873e-4b7a-ac40-5502b88eedc9).Image",
        "Description": "New York. A city built on fragile trust and buried secrets.\nFive individuals have surfaced—each tied to a quiet but dangerous chain of events.\n\nA disgraced banker, recently terminated, now walks a thin line.\nTwo security personnel, unknowingly complicit, must be removed without raising suspicion.\nFabian remains… an unpredictable variable. His fate is yours to decide.\nAnd finally, a drug addict—seemingly insignificant, yet positioned at the wrong place, at the wrong time.\n\nAccidents will tell the story.\nMake it look like the city itself turned against them.\n\nNo witnesses. No patterns. No trace.",
        "GameVersion": "8.23.0.88",
