    "Metadata": {
        "Id": "24592862-cd77-444d-8a24-a3b0380aeffa",
        "Type": "usercreated",
        "Title": "The Soviet Union&#39;s Handiwork (Part 2?)",
        "Location": "LOCATION_ROCKY_DUGONG",
        "PublicId": "134670315306",
        "ScenePath": "assembly:/_pro/scenes/missions/Rocky/scene_dugong.entity",
        "TileImage": "$($repository aa08ec28-bfd8-49ac-872f-c0cbe37e1c9d).Image",
        "Description": "47, we are sad to that after you retrieved the golden AK-47 from Rico Delgado&#39;s armoury, the agents that were tasked with transporting the rifle back to us were KIA, thanks to an ambush by the Delgado cartel.\r\rAfter they took the rifle back from our agents, Rico realized that he could get a lot more money if he was to resell it on the black market. And so, he sold it to the highest bidder, this time to Akka and her pirates.\r\rSo, we ask that you repeat the tasks you performed yesterday, by retrieving the rifle from behind Akka&#39;s desk, eliminating one of her guards with it to send a message, and finally, exiting with the rifle in tow. Hopefully this will be the final time it&#39;s used in a murder.\r\rGood luck, 47.\r\n\r\n<HCCE>",
        "GameVersion": "8.14.0.60",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_ROCKY"
        ],
