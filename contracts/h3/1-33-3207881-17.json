    "Metadata": {
        "Id": "1e838a3a-7a3e-4bd8-9efc-d8dfc829fd4f",
        "Type": "usercreated",
        "Title": "园“灵”艺术：审判者",
        "Location": "LOCATION_ANCESTRAL_SMOOTHSNAKE",
        "PublicId": "133320788117",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_smoothsnake.entity",
        "TileImage": "$($repository d8e4e900-9d14-47c3-b1ca-78927602e4ab).Image",
        "Description": "虽说关于这栋古堡已经有一些阴暗的传闻，但不信邪的人们还是执意要来打搅“主人”的清净，这就是你作为“审判者”出场的理由\r\r你的职责：在人头攒动的园艺会上，精准定位三位自称审判员的目标，然后创造一系列不可思议的幽灵事故，让他们自己接受审判，最后神不知鬼不觉地撤离，只给人们留下关于这座古堡的无尽谜团与猜测……\r\r顺带一提：没必要伤害其他游客，否则会丧失我们工作的艺术性，不是吗？",
        "GameVersion": "8.16.0.0",
        "IsPublished": true,
