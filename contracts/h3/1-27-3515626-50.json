    "Metadata": {
        "Id": "1a078d29-336a-47c2-93fa-ff23a0216890",
        "Type": "usercreated",
        "Title": "Radiator Bleeding",
        "Location": "LOCATION_GOLDEN_GECKO",
        "PublicId": "127351562650",
        "ScenePath": "assembly:/_pro/scenes/missions/golden/mission_gecko/scene_gecko_basic.entity",
        "TileImage": "$($repository 727c2c45-1666-4c35-85f0-48f5ab4f9802).Image",
        "Description": "We&apos;ve made some, to say the least, unfortunate enemies. We suppose before they get a strike on us, we should get one first. Security staff would be too suspicious; so we&apos;re striking maintenance. After all, it would be more believable for the outdoor maintenance worker to fall off the building than an indoor patrolling security guard a floor below. As well as this, security guards don&apos;t handle sharp objects as much as maintenance. I shouldn&apos;t have to say this, but DO NOT GET CAUGHT. Got it?",
        "GameVersion": "8.25.0.0",
