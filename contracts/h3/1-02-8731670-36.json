    "Metadata": {
        "Id": "91e653c5-5fb7-4066-a8e2-98aa7ba98280",
        "Type": "usercreated",
        "Title": "Venomous Vogue",
        "Location": "LOCATION_PARIS",
        "PublicId": "102873167036",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Paris/_scene_paris.entity",
        "TileImage": "$($repository 82879616-4011-42d2-ba39-08a231e79741).Image",
        "Description": "Good afternoon, 47. Today you will be heading to Paris to take out 3 individuals, 2 whom are dressers for the the fashion show. They are secretly working together to take over the fashion industry in the Paris area. The client who hired you for this job had said the 3 targets killed their sister who were also taking part of the fashion show, winning 5 consecutive years. Seemingly, they were jealous and wanted to take her out considering she would most likely win again this year. Good luck, 47.",
        "GameVersion": "8.23.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_PARIS"
        ],
