    "Metadata": {
        "Id": "c57c6813-956f-4b80-9001-a0ad10e83116",
        "Type": "usercreated",
        "Title": "Der Große Stinker und seine Leibgarde",
        "Location": "LOCATION_BANGKOK",
        "PublicId": "108381050368",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Bangkok/_scene_tiger.entity",
        "TileImage": "$($repository c87de1d6-ef5c-44de-8c97-421b609b1633).Image",
        "Description": "Der Große Stinker Stinkt wie noch keiner vor ihm gestunken hat. Selbst die größten Yugioh und World of Warcraft spieler fürchten sich vor ihm. Er wird bewacht von Perversen Indonesern welche von der Höhe auf die Geduschte Masse hinunter Blicken und seine Große stinkigkeit Überwachen. Beseitige den Großen Stinker bevor er eine weitere Toilette schänden kann. Seine Leibgarde wird sich auf dem Dach Selbst befummeln, töte sie auch.",
        "GameVersion": "8.24.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_BANGKOK"
        ],
        "CreatorUserId": "7871c44e-bbd5-4fca-a2a8-a3fbdaaaf05b",
