    "Metadata": {
        "Id": "75a0ba53-8f43-4db0-9105-b3402654dd21",
        "Type": "usercreated",
        "Title": "Murk These Fools Pt. 3",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111124073942",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 79f10ae2-291c-41cb-b55f-017462536286).Image",
        "Description": "What a wonderful day at the races it would have been, if not for these jackwagons. Sierra wouldn&apos;t give me an autograph, her lead mechanic kicked me out the Kronstadt paddock, and Moses told me to &quot;piss off&quot; when I asked for a picture. Then I drank this green, smokey cocktail and got sick, and the doctor was a real dick about it. Oh, and kill Thierry just because I can&apos;t stand his jerk-off face. Got a couple stacks waiting for you when you finish. Ciao!",
        "GameVersion": "8.7.0.0",
