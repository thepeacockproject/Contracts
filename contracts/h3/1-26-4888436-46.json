    "Metadata": {
        "Id": "7128352e-1958-46cb-bf1b-914f9ac887f6",
        "Type": "usercreated",
        "Title": "BCR VOL. 108 - Haven a Bad Day?",
        "Location": "LOCATION_OPULENT_STINGRAY",
        "PublicId": "126488843646",
        "ScenePath": "assembly:/_pro/scenes/missions/Opulent/mission_stingray/scene_stingray_basic.entity",
        "TileImage": "$($repository b53fab67-524b-49d9-96af-31d62f67bbd1).Image",
        "Description": "Good Evening 47. \r\rAfter Dubai, our client came to Haven to recover. He ordered a burger. It arrived with pineapple. When he complained, five people assured him this was &quot;the authentic island experience.&quot;. He has now paid us a frankly embarrassing amount of money to ensure nobody experiences their hospitality again. \r\rEliminate all five. The chef is to be spared; he removed the pineapple and therefore qualifies as a protected witness. \r\rWe are still arguing with Legal.\r\rGood Luck\r-Twiice",
        "GameVersion": "8.26.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_OPULENT"
        ],
