    "Metadata": {
        "Id": "a83215e1-b8be-431f-a1db-4604e4c14a21",
        "Type": "usercreated",
        "Title": "Occult 4: The Hunters",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129400925747",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository 252428ca-3f8e-4477-b2b9-58f18cff3e44).Image",
        "Description": "After getting accses credentials to the cults secret website deep in the dark web: \r\rIntel in the website contains information abou the cults leaders, but more important, a cult calendar. A note states that new live sacrifices are needed for their rituals, so members of the cult are curently in outside of a night club in berlin, scouting for easy targets to kidnap. \r\rEliminate all 5 cult members. Due to the high risk and high visibility of tagets, going long range is highly recommed.",
