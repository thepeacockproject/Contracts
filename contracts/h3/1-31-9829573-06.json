    "Metadata": {
        "Id": "1b89b888-5329-4bc1-9a57-3fcc718aec85",
        "Type": "usercreated",
        "Title": "The Great Hunt for the PS5",
        "Location": "LOCATION_ELEGANT_LLAMA",
        "PublicId": "131982957306",
        "ScenePath": "assembly:/_pro/scenes/missions/elegant/scene_llama.entity",
        "TileImage": "$($repository d2ce60d5-50ee-4119-b255-e560af276c2a).Image",
        "Description": "You would think that 47, of all people, would by now have been rewarded with a PS5. However, the gods haven&apos;t blessed him yet. But because they are all sold out, we had to reach out to someone on Ebay. That person would only sell 47 his PS5 if he can include some footage of him in his new game. So, we said yes, and we thought, there&apos;s nothing better for marketing than explosions while looking like a badass sniper. So, boom. Boom. Just boom.\r\rSincerely, your favorite friend, Diana",
        "GameVersion": "8.7.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_ELEGANT"
        ],
