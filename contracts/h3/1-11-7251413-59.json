    "Metadata": {
        "Id": "d2f3a226-14ed-412a-9e71-21114b95ad85",
        "Type": "usercreated",
        "Title": "The Stinkers",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111725141359",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 9b0d0651-4f81-40e5-bf2a-5aec6fd763a5).Image",
        "Description": "A couple days ago I walked past these guys and they all smelled very strongly of a mixture of SWEAT and PISS, so I would appreciate if you could stop them from violating the sanctity of my nostrils, permanently.\r\rP.S. It would be great if you made it look like a series of unfortunate incidents, with the exeption of TED FUCKING MENDEZ who was INCREDIBLY rude and said I smelled bad! ME! He said I SMELL BAD! I want him ground to a PULP in a WOOD CHIPPER!",
        "GameVersion": "8.11.0.0",
