    "Metadata": {
        "Id": "21472715-0f89-40fc-8164-3f3d8a86ad9f",
        "Type": "usercreated",
        "Title": "5 Bullets Just For You",
        "Location": "LOCATION_NORTHAMERICA",
        "PublicId": "122857074428",
        "ScenePath": "assembly:/_pro/scenes/missions/skunk/scene_skunk.entity",
        "TileImage": "$($repository 856b2aa2-e224-48c3-b890-01fdf4dba6de).Image",
        "Description": "Good morning 47,\r\rThe neighborhood of Whittleton Creek is looking to rent out more homes, and has contracted us to &quot;remove&quot; some of the current homeowners to make room - namely, by putting a bullet in each of their heads. Unfortunately, the ICA has fallen on hard times recently, and could only afford 5 bullets. Make them count, 47.\r\r...What? That one&apos;s a real estate agent? Well, we don&apos;t make the contracts.\r\r(This contract is intended to be done with the Custom 5mm pistol.)",
        "GameVersion": "8.24.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_NORTHAMERICA"
        ],
