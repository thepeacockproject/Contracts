    "Metadata": {
        "Id": "10b9109a-23a5-46dd-a444-a8d5281a13ee",
        "Type": "usercreated",
        "Title": "The Canape Conundrum",
        "Location": "LOCATION_ANCESTRAL_SMOOTHSNAKE",
        "PublicId": "133570221399",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_smoothsnake.entity",
        "TileImage": "$($repository 82dd7654-1eac-4af8-8ec6-5616efe09f1c).Image",
        "Description": "It&apos;s hard to find good catering, even when you&apos;re one of the richest families in England. The Dartmoor Garden Society has had enough of the &quot;Gud Eatz Katering Co&quot; and their gauche, pedestrian canapes. Eliminate the man responsible for this travesty, Jay Harris (2nd runner up on Britain&apos;s Worst Home Cooks), and his three cousins who are acting as &quot;muscle&quot; in case anyone gets irate over the substandard food. Oh, and kill Sebastian Sato while you&apos;re at it for &quot;crimes against fashion.&quot;",
        "GameVersion": "8.6.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_ANCESTRAL"
        ],
