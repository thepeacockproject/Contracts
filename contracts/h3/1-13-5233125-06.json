    "Metadata": {
        "Id": "a6cba02b-d746-4a1b-8b34-49fbe9983472",
        "Type": "usercreated",
        "Title": "Get My Wiener Back!",
        "Location": "LOCATION_MUMBAI",
        "PublicId": "113523312506",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Mumbai/scene_mongoose.entity",
        "TileImage": "$($repository a8d24110-0839-43eb-a1a0-493d4c485da9).Image",
        "Description": "I apologize for my absence on last week&apos;s Friday Night Streamorino, however I was off traveling to Chicago to meet with a meteorologist at United Airlines, I learned a lot about the job and it was a very nice experience.\r\rWhile there, I attempted to get one of the famous hotdogs from a stand by the lakefront, when this Indian dude snatched it from me! It seems he&apos;s taken it back to Mumbai where he plans on enjoying it with some buddies. Kill them and get my wiener back!\r\rBest regards, Eclipse",
