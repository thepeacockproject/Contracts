    "Metadata": {
        "Id": "f955099c-cf78-42d1-be8a-d0086e42aafd",
        "Type": "usercreated",
        "Title": "The Kronstadt Conspiracy",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111801879162",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository ee2af034-8ebe-43f8-a8f3-525e060dbb31).Image",
        "Description": "Robert Knox of Kronstadt Industries has hired us to tie up some &quot;loose ends&quot;.\r\r1. Your primary objective is the death of rival racer Moses Lee. Knox would prefer he be given the chance to take him out, via car bomb, but any method works.\r\r2. Baltazar Morrison, originally hired by Knox to kill Lee, has been captured by security, and must be silenced before he talks.\r\r3. Lastly, a man named Albert Noah has dirt on Knox, and has been threatening blackmail. You know what do.\r\rGood luck, 47.",
