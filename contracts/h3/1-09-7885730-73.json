    "Metadata": {
        "Id": "ed18fa41-a1c3-4e87-b9a1-b4d681b50ac6",
        "Type": "usercreated",
        "Title": "Ghosts of Colorado",
        "Location": "LOCATION_COLORADO",
        "PublicId": "109788573073",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Colorado_2/_scene_bull.entity",
        "TileImage": "$($repository e26960bc-a980-42f7-ba98-3b52b42264ce).Image",
        "Description": "Colorado is crawling with militia operatives, but five individuals stand out from the rest.\nDonald Banks, Cary Dunson, Dennis Chapin, Frank Chappell, and Milton Geiger all played their part in keeping the compound running.\n\nYour objective is simple: remove them without drawing unnecessary attention.\nAccidents are preferred, but creativity is always welcome.\n\nThe militia believes they control this farm.\nShow them how fragile that control really is.\n\nGood luck, 47.",
