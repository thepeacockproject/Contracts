    "Metadata": {
        "Id": "d56238a9-8e0d-4be9-9ca9-f816fe43fa8d",
        "Type": "usercreated",
        "Title": "Volunteering for the Good of the People",
        "Location": "LOCATION_WET_RAT",
        "PublicId": "130383528514",
        "ScenePath": "assembly:/_pro/scenes/missions/wet/scene_rat_basic.entity",
        "TileImage": "$($repository 9e6e0c2b-22fb-4db9-9cc3-450b1d2d051c).Image",
        "Description": "The city of Chongqing had to fire their sewage workers due to budget cuts. Luckily, you have offered to volunteer.  Problem is that you&apos;re alone and they need at least five workers. So now it&apos;s your job to find the other four. It&apos;s your choice if you want to convince or &quot;convince&quot; them, but lookin at what you want from them, the latter seems like the better choice. The city already gave you a uniform, and it would be a shame if you were to loose it, so it&apos;s advised to keep it on at all times.",
        "GameVersion": "8.25.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_WET"
        ],
