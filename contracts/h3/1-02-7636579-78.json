    "Metadata": {
        "Id": "1f52a9eb-da14-48d0-9284-bea3a4d18463",
        "Type": "usercreated",
        "Title": "[AUoA]: Stolen Glamour",
        "Location": "LOCATION_PARIS",
        "PublicId": "102763657978",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Paris/_scene_paris.entity",
        "TileImage": "$($repository aa1c8b40-8692-11e4-a689-07980bf9330f).Image",
        "Description": "Good evening, Agent 47.\r\rYour destination is the Sanguine fashion show in Paris. Our client, scheduled to debut here in a few months, was surprised to find their designs already on display, stolen by designer Sebastian Sato. Worse still, Sato is auctioning off the stolen material upstairs -- perhaps one last grasp at personal fortune. As fate would have it, we already have a personal interest in ensuring this auction ceases operation, so we decided to assist..\r\rYour primary target is Nicolas Frank, the lead auctioneer. To satisfy our client, Sebastian Sato and his source within the palace staff, Christophe Nightlinglam, must be eliminated.\r\rI&#39;ll leave you to prepare.",
        "GameVersion": "8.23.0.88",
