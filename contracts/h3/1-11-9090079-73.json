    "Metadata": {
        "Id": "cbcbb8b2-6057-4dc2-9b64-59b08925f62e",
        "Type": "usercreated",
        "Title": "Bird is the Word",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111909007973",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 6105f0a4-6169-48f3-9e54-764cf4ec991b).Image",
        "Description": "Good Afternoon 47, \rWe have a contract in from a High-End client, who insist the Miami races are being rigged and misrepresented. Your first target is Dennis Elliot, a race marshal, highly regarded as responsible for the rigging. Secondly, Ruperto Devine, a Commentator , highly noted for his &quot;explosive personality&quot;... if you catch the drift. You may find a gadegt to pack a punch around miami somewhere.\rFinally, &quot;Fishy Joe&quot;, a street dealer who is getting a little too big for his boots.\rGood Luck",
        "GameVersion": "8.23.0.0",
        "IsPublished": true,
