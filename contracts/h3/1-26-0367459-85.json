    "Metadata": {
        "Id": "0bef920f-390c-48bb-b64b-08b3d279d80e",
        "Type": "usercreated",
        "Title": "Muffin, Man?",
        "Location": "LOCATION_OPULENT_STINGRAY",
        "PublicId": "126036745985",
        "ScenePath": "assembly:/_pro/scenes/missions/Opulent/mission_stingray/scene_stingray_basic.entity",
        "TileImage": "$($repository cee4e428-1efb-42ef-8eb5-763822781738).Image",
        "Description": "Five muffins, five accidents.\r\rOur client, Helen West, wants to show the world the true potential of her delicious baked goods. Take out your targets solely by throwing muffins at them.\r\rBe sure to bring some muffins with you, 47, and grab the extra two from the fridge in the kitchen. In a pinch, you can substitute with some coconuts or a cheeseburger.\r\rMake sure to take out the jetskiers only after they&apos;ve started moving in order to fulfill the contract conditions.\r\rI&apos;ll leave you to prepare.",
        "GameVersion": "8.7.0.0",
