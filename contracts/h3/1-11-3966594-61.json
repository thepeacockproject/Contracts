    "Metadata": {
        "Id": "77b5bdcf-f655-452d-86dd-f8053af48b4b",
        "Type": "usercreated",
        "Title": "BURN BABY BURN",
        "Location": "LOCATION_MIAMI",
        "PublicId": "111396659461",
        "ScenePath": "assembly:/_pro/scenes/missions/miami/scene_flamingo.entity",
        "TileImage": "$($repository 9789c707-f4f7-4a66-b955-7e54550d7ff9).Image",
        "Description": "Moses Lee is very sick of Sierra Knox and her attitude. He wants her gone, and has provided us a uniform to use to get into the garages where her mechanics will be residing. He requests that we eliminate core members of her team to cripple her racing career, and prevent her from returning to the track.\r\rGood Luck 47",
        "GameVersion": "8.3.0.0",
        "IsPublished": true,
