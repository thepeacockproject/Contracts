    "Metadata": {
        "Id": "56ee096d-ef2e-4793-b10d-8676120da4d6",
        "Type": "usercreated",
        "Title": "Learn Macedonian With Me!",
        "Location": "LOCATION_COASTALTOWN_MOVIESET",
        "PublicId": "105506853106",
        "ScenePath": "assembly:/_pro/scenes/missions/coastaltown/_scene_copperhead.entity",
        "TileImage": "$($repository acd3d54b-2954-4613-9989-8997c8b99240).Image",
        "Description": "Hello there!\r\r47, this is Agent Eclipse speaking. To prepare for a future mission to the prestine country of North Macedonia, it&apos;s time you learn some Macedonian. And guess what?! I can teach you.\r\rEach of these contracts will include a single word, and the task of the contract is themed with whatever the word is.\r\rToday&apos;s word is &quot;white&quot;, which in Macedonian is бел (&quot;bel&quot; in the Latin script). Because of this word, you need to dress as the White Ninja and bring white things along.\r\rGood luck.",
        "GameVersion": "8.15.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_COASTALTOWN"
        ],
