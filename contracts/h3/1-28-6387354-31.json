    "Metadata": {
        "Id": "d32693e9-eae6-4b56-bfc2-1463fb99b3a0",
        "Type": "usercreated",
        "Title": "Tarik der Hitman (Aber er kommt nie)",
        "Location": "LOCATION_ANCESTRAL_BULLDOG",
        "PublicId": "128638735431",
        "ScenePath": "assembly:/_pro/scenes/missions/Ancestral/scene_bulldog.entity",
        "TileImage": "$($repository 02bdd2c2-4311-4d62-a699-fa4ee07fc55f).Image",
        "Description": "Ja, hier kommt Tarik, der Hitman, doch sein Ziel verfehlt er oft. Die Missionen sind zu schwer für ihn, ein Highscore wird er nie erzielen. Die Targets haben keine Angst, Mendoza Paris er hat keine Chance.\rTarik, der Hitman, doch kein Treffer ist in Sicht. Seine Gegner lachen laut, bis er ihnen am Schwoneck saugt. Er zielt und schießt, doch trifft nur Luft.\rTarik, der Hitman, ist bekannt für seine Eifersucht. Ragequit, garantiert, wenn man sein Gameplay sieht.",
        "GameVersion": "8.25.0.0",
