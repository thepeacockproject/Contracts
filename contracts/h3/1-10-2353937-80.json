    "Metadata": {
        "Id": "5fad5f82-ad40-4b00-b78c-c7e59458e9e9",
        "Type": "usercreated",
        "Title": "Director&apos;s Cut",
        "Location": "LOCATION_HOKKAIDO",
        "PublicId": "110235393780",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Hokkaido/_scene_snowcrane.entity",
        "TileImage": "$($repository 2e1a30c5-b1e0-4984-b3f4-67f01f9ebfef).Image",
        "Description": "Our client is a personal friend and business associate of Dr. Ito. He has discovered that the Gama hospital director has discovered the illegal organ trade in the hospital and is planning to go to the authorities. It would be bad for business if that were to happen. \rIntel reveals the director had confided in his two close friends and a pair of security guards. Eliminate them all, discreetly if possible. After your exit, our client will send replacement staff and cleanup crew to the hospital.",
        "GameVersion": "8.1.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_HOKKAIDO"
        ],
