    "Metadata": {
        "Id": "a461b1d4-2078-424f-b242-b32d347c94ef",
        "Type": "usercreated",
        "Title": "47 does what Nintendon&apos;t",
        "Location": "LOCATION_EDGY_FOX",
        "PublicId": "129916702775",
        "ScenePath": "assembly:/_pro/scenes/missions/edgy/mission_fox/scene_fox_contractcreation.entity",
        "TileImage": "$($repository 633398ac-c4b4-4441-852d-ae6460172025).Image",
        "Description": "Good Evening 47,\r\rThe ICA has been contracted by a certain major video game company whose name we cannot disclose. They have tasked us with the removal of four individuals who are developing an emulator for a console the company made 20 years ago. This is simply not acceptable to our client.\r\rAlso, two of your targets are suspected in ripping ROM files from games they own and uploading them to the public. Our client has requested you kill them in specific ways to make an example.\r\rGood luck, 47.",
        "GameVersion": "8.25.0.0",
