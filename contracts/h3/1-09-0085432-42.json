    "Metadata": {
        "Id": "350a07e6-5d24-4494-b5f8-a6da102e1ba0",
        "Type": "usercreated",
        "Title": "BCR Vol. 94 - The Crows Revenge",
        "Location": "LOCATION_COLORADO",
        "PublicId": "109008543242",
        "ScenePath": "assembly:/_PRO/Scenes/Missions/Colorado_2/_scene_bull.entity",
        "TileImage": "$($repository 90e997f4-67c6-486d-afb9-63c4424b1fd1).Image",
        "Description": "&quot;Hahaha yeah! And that one time Ewan drew cocks all over it? Hahahaha or when we all set it on Fire?? Hahaha....&quot;\rSlowly the laughs fade away as your focus slips. The surroundings blending into blissful imaginations of taking revenge and standing over their dead bodies. Every night they do this. Turning your whole being into a shameful laughing stock when you are supposed to be the SCAREcrow. But enough is enough and you&apos;ll show them alright. Because this night...they will remember.\r\rBy Celllie",
        "GameVersion": "8.24.0.0",
        "IsPublished": true,
        "Entitlements": [
            "LOCATION_COLORADO"
        ],
