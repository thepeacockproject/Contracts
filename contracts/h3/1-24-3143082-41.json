    "Metadata": {
        "Id": "09ef9a14-8836-4e17-aa80-dc749a05d1d0",
        "Type": "usercreated",
        "Title": "Quickdraw Slackers",
        "Location": "LOCATION_GREEDY_RACCOON",
        "PublicId": "124314308241",
        "ScenePath": "assembly:/_pro/scenes/missions/Greedy/mission_raccoon/scene_raccoon_basic.entity",
        "TileImage": "$($repository f7606890-2c29-4e9c-973b-9ae71facf9f6).Image",
        "Description": "Fabian Mann has called us once again back to the Milton-Fitzpatrick Bank to deal with some slackers on the job. There are more slackers then we have listed, but Fabian has sugested that this just might send them all a message. To not raise any suspicion, Fabian is requring us to go undercover and to leave any envidence behind. This means having no bodies found and the cameras cleared, happy hunting 47.",
